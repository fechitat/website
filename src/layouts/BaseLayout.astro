---
// Layout base: estructura HTML común (header, contenido, footer, fuentes y
// estilos globales) con SEO, accesibilidad y PWA.
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PwaBottomNav from "../components/ui/PwaBottomNav.astro";
import OfflineToast from "../components/ui/OfflineToast.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Ruta absoluta de imagen para Open Graph. */
  ogImage?: string;
  /** Datos estructurados adicionales de la página. */
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Evita indexar páginas auxiliares como la paginación. */
  noindex?: boolean;
  mostrarFooter?: boolean;
}

const {
  title,
  description,
  ogImage = "/images/social/fechitat-social.jpg",
  structuredData,
  noindex = false,
  mostrarFooter = true,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site ?? "https://fechitat-website.vercel.app");

const jsonLdOrganizacion = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: "FECHITAT",
  alternateName: "Federación Chilena de Taekwon-Do Tradicional",
  url: "https://fechitat-website.vercel.app",
  logo: "https://fechitat-website.vercel.app/images/general/fechitat-logo.svg",
  email: "contacto@fechitat.cl",
  sport: "Taekwon-Do ITF",
  areaServed: { "@type": "Country", name: "Chile" },
  sameAs: [],
});

const jsonLdAdicional = structuredData
  ? JSON.stringify(Array.isArray(structuredData) ? structuredData : [structuredData])
  : null;
const imagenSocial = new URL(ogImage, Astro.site ?? "https://fechitat-website.vercel.app");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0b1220" />
    <meta name="google-site-verification" content="B7F13jj208ydD6dWrfncw3sQ59mEi_yhj7v1W4Hr3cg" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FECHITAT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`FECHITAT — ${title}`} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenSocial} />
    <meta name="twitter:image:alt" content={`FECHITAT — ${title}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Recursos ITF" />
    <!-- Tipografía propia autoalojada (sin dependencias externas de Google Fonts) -->
    <link rel="preload" href="/fonts/kumbh-sans.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Datos estructurados: organización (global) -->
    <script type="application/ld+json" set:html={jsonLdOrganizacion}></script>
    {jsonLdAdicional && <script type="application/ld+json" set:html={jsonLdAdicional}></script>}

    {import.meta.env.PUBLIC_GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
        <script is:inline define:vars={{ measurementId: import.meta.env.PUBLIC_GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(...args) { window.dataLayer.push(args); }
          gtag('js', new Date());
          gtag('config', measurementId, { anonymize_ip: true });
        </script>
      </>
    )}

    <ClientRouter />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-white focus:px-4 focus:py-2 focus:rounded-sm focus:text-sm"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" transition:animate="fade" class:list={[Astro.url.pathname.startsWith('/recursos') ? 'pb-16 md:pb-0' : '']}>
      <slot />
    </main>
    {mostrarFooter && <Footer />}
    <PwaBottomNav />
    <OfflineToast />
    <script>
      import "../scripts/main.js";
    </script>
    <script is:inline>
      // Registro del service worker (PWA / offline)
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* Sin registro si el entorno no lo permite (dev) */
          });
        });
      }
    </script>
  </body>
</html>
