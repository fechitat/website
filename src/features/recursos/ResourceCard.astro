---
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import UIcon from '../../components/icons/UIcon.astro';
import { RESOURCE_FORMATS, type CatalogResource } from './catalogo';

interface Props {
  resource: CatalogResource;
  headingLevel?: 'h2' | 'h3';
  variant?: 'standard' | 'featured';
}

const { resource, headingLevel: Heading = 'h2', variant = 'standard' } = Astro.props;
const format = RESOURCE_FORMATS.find((option) => option.id === resource.format);

// Icono temático para hacer visualmente identificable cada card
const iconosPorRecurso: Record<string, string> = {
  'programa-examen': '🥋',
  'terminologia': '🗣️',
  'temporizador-formas': '⏱️',
  'evaluacion-examen': '📋',
  'diagramas-tuls': '📐',
};
const cardEmoji = iconosPorRecurso[resource.id] ?? (format?.icon === 'wrench' ? '🔧' : format?.icon === 'book-open' ? '📖' : '📄');
---

<Card href={resource.href} class={`resource-card group h-full block rounded-xl border border-line bg-white shadow-xs hover:border-red hover:shadow-md transition-all${variant === 'featured' ? ' resource-card--featured' : ''}`}>
  <div class="p-5 sm:p-6 h-full flex flex-col">
    <div class="flex items-center justify-between gap-3 mb-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-paper text-ink border border-line">
        {format?.label ?? resource.category.label}
      </span>
      <span class="text-2xl p-1.5 rounded-lg bg-paper shrink-0 select-none" aria-hidden="true">
        {cardEmoji}
      </span>
    </div>
    <Heading class="text-lg sm:text-xl font-bold font-heading leading-snug tracking-normal mb-0 text-ink group-hover:text-red transition-colors">
      {resource.title}
    </Heading>
    {resource.description && (
      <p class="resource-description text-sm text-text-soft mt-2 mb-0 leading-relaxed line-clamp-3">
        {resource.description}
      </p>
    )}
    {resource.details && resource.details.length > 0 && (
      <p class="text-xs text-text-soft/80 mt-2 mb-0 leading-relaxed">
        {resource.details.join(' · ')}
      </p>
    )}
    <div class="mt-auto pt-5">
      <Button as="span" variant="brand" class="w-full justify-center group-hover:bg-red-dark text-sm font-bold min-h-11">
        Abrir recurso
        <UIcon name="arrow-up-right" size={16} class="shrink-0" />
      </Button>
    </div>
  </div>
</Card>

<style>
  :global(.resource-card) {
    transition: border-color 150ms, box-shadow 150ms, transform 150ms;
    overflow-wrap: anywhere;
  }

  :global(.resource-card--featured),
  :global(.resource-card:hover),
  :global(.resource-card:focus-visible) {
    border-color: var(--color-red);
  }

  :global(.resource-card--noticia.resource-card--featured),
  :global(.resource-card--noticia:hover),
  :global(.resource-card--noticia:focus-visible) {
    border-color: var(--color-blue);
  }

  :global(.resource-card:focus-visible) {
    outline: 2px solid var(--color-red);
    outline-offset: 3px;
  }

  :global(.resource-card--noticia:focus-visible) {
    outline-color: var(--color-blue);
  }

  :global(.resource-card:active) {
    background: var(--color-paper);
  }

  /* El teclado permite leer el extracto completo sin depender del hover. */
  :global(.resource-card:focus-visible) .resource-description {
    display: block;
    -webkit-line-clamp: unset;
  }
</style>
