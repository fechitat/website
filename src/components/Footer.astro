---
import UIcon from "./icons/UIcon.astro";
import SocialLinks from "./SocialLinks.astro";

const anioActual = new Date().getFullYear();
---

<footer class="bg-ink text-light-soft">
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-14 xl:px-16">
    <div class="mb-10 flex flex-col gap-5 border-b border-white/10 pb-8 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="mb-3 flex items-center gap-3 text-white">
          <img
            src="/images/general/fechitat-logo.svg"
            alt="Logo FECHITAT"
            width="52"
            height="52"
            class="h-12 w-12 object-contain"
          />
          <span class="font-heading text-lg font-extrabold tracking-[0.08em]">FECHITAT</span>
        </div>
        <p class="max-w-[58ch] text-sm leading-relaxed text-light-muted">
          Federación Chilena de Taekwon-Do Tradicional, afiliada a ITF. Formamos artistas marciales con disciplina, respeto y proyección internacional.
        </p>
      </div>
      <div class="flex items-center gap-4" aria-label="Federaciones afiliadas">
        <img src="/images/general/itf-logo.png" alt="International Taekwon-Do Federation" width="48" height="48" class="h-12 w-12 object-contain" />
        <img src="/images/general/logo_panam.webp" alt="Panamerican Taekwon-Do Federation" width="48" height="48" class="h-12 w-12 object-contain" />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="mb-3 text-sm font-bold normal-case text-white">Federación</h2>
        <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm">
          <li><a href="/federacion" class="transition-colors hover:text-white">Quiénes somos</a></li>
          <li><a href="/federacion/documentos" class="transition-colors hover:text-white">Estatutos y documentos</a></li>
          <li><a href="/federacion#directivos" class="transition-colors hover:text-white">Directiva</a></li>
          <li><a href="/escuelas" class="transition-colors hover:text-white">Escuelas afiliadas</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-3 text-sm font-bold normal-case text-white">Participar</h2>
        <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm">
          <li><a href="/padres" class="transition-colors hover:text-white">Familias y nuevos alumnos</a></li>
          <li><a href="/jovenes" class="transition-colors hover:text-white">Área competitiva</a></li>
          <li><a href="/eventos" class="transition-colors hover:text-white">Calendario</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-3 text-sm font-bold normal-case text-white">Recursos</h2>
        <ul class="m-0 flex list-none flex-col gap-2 p-0 text-sm">
          <li><a href="/recursos/formacion/programa-examen" class="transition-colors hover:text-white">Programa de examen</a></li>
          <li><a href="/recursos/formacion/terminologia" class="transition-colors hover:text-white">Terminología</a></li>
          <li><a href="/federacion/documentos" class="transition-colors hover:text-white">Reglamentos</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-3 text-sm font-bold normal-case text-white">Contacto</h2>
        <ul class="m-0 mb-2 flex list-none flex-col gap-2 p-0 text-sm">
          <li>
            <a href="mailto:contacto@fechitat.cl" class="inline-flex items-center gap-2 text-light-soft transition-colors hover:text-white">
              <UIcon name="mail" size={15} class="shrink-0" />
              <span>contacto@fechitat.cl</span>
            </a>
          </li>
          <li>
            <a href="tel:+56988889668" class="inline-flex items-center gap-2 text-light-soft transition-colors hover:text-white">
              <UIcon name="phone" size={15} class="shrink-0" />
              <span>+569 8888 9668</span>
            </a>
          </li>
        </ul>
        <SocialLinks mostrarNombres class="flex flex-col items-start gap-2" />
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-5 text-xs text-light-muted sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">© {anioActual} FECHITAT. Todos los derechos reservados.</p>
      <p class="m-0"><a href="/federacion/documentos" class="hover:text-white">Documentos oficiales</a></p>
    </div>
  </div>
</footer>
