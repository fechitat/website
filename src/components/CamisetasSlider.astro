---
/**
 * CamisetasSlider.astro
 *
 * Carrusel de camisetas/uniformes históricos de FECHITAT.
 * Muestra foto grande (frente/dorso), año, evento, colores, diseñador y ciudad.
 *
 * Uso:
 *   import CamisetasSlider from '@/components/CamisetasSlider.astro'
 *   const camisetas = await getCamisetas()
 *   <CamisetasSlider camisetas={camisetas} />
 */

import { urlFor } from '../lib/sanity'

interface Color {
  nombre: string
  hex: string
}

interface Camiseta {
  _id: string
  titulo: string
  periodo: string
  anioOrden: number
  imagenFrente?: any
  imagenDorso?: any
  coloresPrincipales?: Color[]
  disenador?: string
  lugarEvento?: string
  descripcion?: string
}

interface Props {
  camisetas: Camiseta[]
  titulo?: string
  subtitulo?: string
}

const {
  camisetas,
  titulo = 'Nuestras camisetas',
  subtitulo = 'La indumentaria que ha representado a Chile en el taekwondo ITF a lo largo de los años.',
} = Astro.props

const hayDatos = camisetas && camisetas.length > 0
---

{hayDatos && (
  <section class="camisetas-slider py-16 md:py-24 bg-ink text-white overflow-hidden" aria-label="Camisetas históricas">
    <div class="max-w-7xl mx-auto px-5">

      <!-- Encabezado -->
      <div class="mb-10 md:mb-14">
        <p class="font-mono text-xs tracking-widest uppercase text-red mb-3">Historia</p>
        <h2 class="text-3xl md:text-4xl font-bold leading-tight">{titulo}</h2>
        {subtitulo && (
          <p class="mt-3 text-light-soft text-base md:text-lg max-w-2xl">{subtitulo}</p>
        )}
      </div>

      <!-- Slider principal -->
      <div class="camisetas-wrapper relative" data-camisetas-total={camisetas.length}>

        <!-- Track de slides -->
        <div class="camisetas-track" role="list">
          {camisetas.map((item, i) => {
            const frenteUrl = item.imagenFrente
              ? urlFor(item.imagenFrente).width(800).height(900).fit('crop').url()
              : null
            const dorsoUrl = item.imagenDorso
              ? urlFor(item.imagenDorso).width(800).height(900).fit('crop').url()
              : null

            return (
              <article
                class="camiseta-slide"
                role="listitem"
                data-index={i}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-center">

                  <!-- Fotos -->
                  <div class="fotos-grupo flex gap-4 justify-center">
                    <!-- Frente (principal) -->
                    <div class="foto-principal relative">
                      {frenteUrl ? (
                        <img
                          src={frenteUrl}
                          alt={`${item.titulo} — frente`}
                          class="w-full max-w-xs object-cover rounded-xl shadow-2xl border border-white/10"
                          loading={i === 0 ? 'eager' : 'lazy'}
                        />
                      ) : (
                        <div class="w-full max-w-xs aspect-[4/5] rounded-xl bg-white/5 border border-white/10 flex items-center justify-center">
                          <span class="text-6xl opacity-20">👕</span>
                        </div>
                      )}
                      <span class="foto-label">Frente</span>
                    </div>

                    <!-- Dorso (secundario, si existe) -->
                    {dorsoUrl && (
                      <div class="foto-secundaria relative self-end">
                        <img
                          src={dorsoUrl}
                          alt={`${item.titulo} — dorso`}
                          class="w-full max-w-[180px] object-cover rounded-xl shadow-xl border border-white/10 opacity-80 hover:opacity-100 transition-opacity"
                          loading="lazy"
                        />
                        <span class="foto-label">Dorso</span>
                      </div>
                    )}
                  </div>

                  <!-- Info -->
                  <div class="info-grupo">
                    <!-- Año badge -->
                    <div class="inline-flex items-center gap-2 bg-red/10 border border-red/30 rounded-full px-4 py-1 mb-6">
                      <span class="w-2 h-2 rounded-full bg-red inline-block"></span>
                      <span class="font-mono text-sm text-red font-semibold">{item.periodo}</span>
                    </div>

                    <h3 class="text-2xl md:text-3xl font-bold mb-4 leading-snug">{item.titulo}</h3>

                    {item.descripcion && (
                      <p class="text-light-soft text-base leading-relaxed mb-6">{item.descripcion}</p>
                    )}

                    <!-- Meta datos -->
                    <dl class="meta-lista">
                      {item.lugarEvento && (
                        <div class="meta-item">
                          <dt>Lugar</dt>
                          <dd>{item.lugarEvento}</dd>
                        </div>
                      )}
                      {item.disenador && (
                        <div class="meta-item">
                          <dt>Diseñador / Proveedor</dt>
                          <dd>{item.disenador}</dd>
                        </div>
                      )}
                    </dl>

                    <!-- Colores -->
                    {item.coloresPrincipales && item.coloresPrincipales.length > 0 && (
                      <div class="colores-grupo mt-6">
                        <p class="font-mono text-xs uppercase tracking-widest text-light-soft mb-3">Colores</p>
                        <div class="flex flex-wrap gap-3">
                          {item.coloresPrincipales.map((c) => (
                            <div class="color-chip" title={c.nombre}>
                              <span
                                class="color-swatch"
                                style={`background-color: ${c.hex || '#888'}`}
                                aria-hidden="true"
                              ></span>
                              <span class="color-nombre">{c.nombre}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                </div>
              </article>
            )
          })}
        </div>

        <!-- Controles de navegación -->
        <div class="controles-nav" aria-label="Navegación del carrusel">

          <!-- Botones prev/next -->
          <div class="nav-botones">
            <button
              class="nav-btn nav-prev"
              data-prev
              aria-label="Camiseta anterior"
              disabled
            >
              ←
            </button>
            <button
              class="nav-btn nav-next"
              data-next
              aria-label="Siguiente camiseta"
            >
              →
            </button>
          </div>

          <!-- Indicadores de posición (dots) -->
          <div class="nav-dots" role="tablist" aria-label="Camisetas">
            {camisetas.map((item, i) => (
              <button
                class:list={['dot', i === 0 ? 'dot--active' : '']}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`${item.periodo} — ${item.titulo}`}
                data-dot={i}
              ></button>
            ))}
          </div>

          <!-- Contador numérico -->
          <p class="nav-counter font-mono text-xs text-light-soft" aria-live="polite">
            <span data-current>1</span> / <span data-total>{camisetas.length}</span>
          </p>

        </div>
      </div>

    </div>
  </section>
)}

{!hayDatos && (
  <!-- Estado vacío: no renderiza nada, el bloque no se muestra -->
  <></>
)}

<style>
  /* ------------------------------------------------------------------ */
  /* Track y slides                                                        */
  /* ------------------------------------------------------------------ */
  .camisetas-track {
    position: relative;
    min-height: 400px;
  }

  .camiseta-slide {
    display: none;
    animation: fadeSlide 0.4s ease both;
  }

  .camiseta-slide[aria-hidden="false"] {
    display: block;
  }

  @keyframes fadeSlide {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ------------------------------------------------------------------ */
  /* Fotos                                                                 */
  /* ------------------------------------------------------------------ */
  .foto-principal,
  .foto-secundaria {
    position: relative;
    display: inline-block;
  }

  .foto-label {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e2e8f0;
    white-space: nowrap;
  }

  .fotos-grupo {
    padding-bottom: 2rem; /* espacio para las labels */
  }

  /* ------------------------------------------------------------------ */
  /* Meta lista                                                            */
  /* ------------------------------------------------------------------ */
  .meta-lista {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .meta-item dt {
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #cbd5e1;
    white-space: nowrap;
    min-width: 120px;
  }

  .meta-item dd {
    font-size: 0.95rem;
    color: #ffffff;
  }

  /* ------------------------------------------------------------------ */
  /* Colores                                                               */
  /* ------------------------------------------------------------------ */
  .color-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255 255 255 / 0.06);
    border: 1px solid rgba(255 255 255 / 0.15);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem 0.25rem 0.4rem;
  }

  .color-swatch {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(255 255 255 / 0.2);
    flex-shrink: 0;
  }

  .color-nombre {
    font-size: 0.8rem;
    color: #f8fafc;
  }

  /* ------------------------------------------------------------------ */
  /* Controles                                                             */
  /* ------------------------------------------------------------------ */
  .controles-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .nav-botones {
    display: flex;
    gap: 0.5rem;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255 255 255 / 0.2);
    background: transparent;
    color: white;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .nav-btn:hover:not(:disabled) {
    background: rgba(255 255 255 / 0.1);
    border-color: rgba(255 255 255 / 0.5);
  }

  .nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Dots */
  .nav-dots {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255 255 255 / 0.25);
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }

  .dot:hover {
    background: rgba(255 255 255 / 0.5);
  }

  .dot--active {
    background: var(--fechitat-red, #d21111);
    transform: scale(1.3);
  }

  .nav-counter {
    margin-left: auto;
  }
</style>

<script is:inline>
  (function () {
    const wrapper = document.querySelector('[data-camisetas-total]')
    if (!wrapper) return

    const slides = wrapper.querySelectorAll('.camiseta-slide')
    const dots = wrapper.querySelectorAll('[data-dot]')
    const prevBtn = wrapper.querySelector('[data-prev]')
    const nextBtn = wrapper.querySelector('[data-next]')
    const currentEl = wrapper.querySelector('[data-current]')
    const total = slides.length

    let current = 0

    function goTo(index) {
      slides[current].setAttribute('aria-hidden', 'true')
      dots[current].classList.remove('dot--active')
      dots[current].setAttribute('aria-selected', 'false')

      current = (index + total) % total

      slides[current].setAttribute('aria-hidden', 'false')
      dots[current].classList.add('dot--active')
      dots[current].setAttribute('aria-selected', 'true')

      if (currentEl) currentEl.textContent = String(current + 1)
      if (prevBtn) prevBtn.disabled = current === 0
      if (nextBtn) nextBtn.disabled = current === total - 1
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1))
    nextBtn?.addEventListener('click', () => goTo(current + 1))
    dots.forEach((dot) => {
      dot.addEventListener('click', () => goTo(Number(dot.dataset.dot)))
    })

    // Swipe táctil
    let startX = 0
    wrapper.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX }, { passive: true })
    wrapper.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX
      if (Math.abs(dx) > 50) goTo(dx < 0 ? current + 1 : current - 1)
    }, { passive: true })

    // Teclado (flechas cuando el foco está dentro)
    wrapper.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo(current + 1)
      if (e.key === 'ArrowLeft') goTo(current - 1)
    })

    // Estado inicial
    goTo(0)
  })()
</script>
