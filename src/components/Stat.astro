---
// Estadística con contador animado (data-count) + label usando jerarquía tipográfica limpia.
interface Props {
  count: number;
  suffix?: string;
  label: string;
  dark?: boolean;
}

const { count, suffix = '', label, dark = false } = Astro.props;
---

<div>
  <div
    class:list={[
      'font-heading font-extrabold text-[2.75rem] leading-none tracking-tight',
      dark ? 'text-white' : 'text-ink',
    ]}
    data-count={count}
    data-suffix={suffix}
  >{count}{suffix}</div>
  <div
    class:list={[
      'font-mono text-xs font-semibold tracking-wider uppercase mt-2',
      dark ? 'text-light-muted' : 'text-text-soft',
    ]}
  >{label}</div>
</div>
