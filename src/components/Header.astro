---
const { pathname } = Astro.url;

const esActivo = (href) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const federacionActiva = esActivo("/federacion") || esActivo("/escuelas");
const recursosActivos = esActivo("/recursos") || esActivo("/blog");
---

<header class="sticky top-0 z-50 bg-ink border-b border-white/10">
  <div class="max-w-6xl mx-auto px-5 md:px-7 flex items-center justify-between h-16 md:h-17">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white font-heading font-extrabold tracking-wide text-base md:text-lg" aria-label="FECHITAT — Inicio">
      <img src="/images/general/fechitat-logo.svg" alt="" width="36" height="36" class="w-9 h-9 object-contain" />
      <span>FECHITAT</span>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      <a
        href="/"
        data-astro-prefetch="hover"
        class="font-mono text-xs tracking-widest uppercase py-1 border-b-2 border-transparent transition-colors duration-150"
        class:list={esActivo("/") ? "text-white border-red" : "text-light-soft hover:text-white hover:border-red"}
      >
        Inicio
      </a>

      <details class="relative group">
        <summary
          class:list={[
            "list-none cursor-pointer font-mono text-xs tracking-widest uppercase py-1 border-b-2 border-transparent transition-colors duration-150 flex items-center gap-2",
            federacionActiva ? "text-white border-red" : "text-light-soft hover:text-white hover:border-red",
          ]}
        >
          Federación <span aria-hidden="true">⌄</span>
        </summary>
        <div class="absolute left-0 top-full mt-3 min-w-52 bg-ink border border-white/15 rounded-sm p-2 shadow-xl">
          <a href="/federacion" class="block px-3 py-2 text-light-soft hover:text-white hover:bg-white/10 font-mono text-xs uppercase tracking-wider">Quiénes somos</a>
          <a href="/escuelas" class="block px-3 py-2 text-light-soft hover:text-white hover:bg-white/10 font-mono text-xs uppercase tracking-wider">Escuelas afiliadas</a>
        </div>
      </details>

      <a
        href="/eventos"
        data-astro-prefetch="hover"
        class="font-mono text-xs tracking-widest uppercase py-1 border-b-2 border-transparent transition-colors duration-150"
        class:list={esActivo("/eventos") ? "text-white border-red" : "text-light-soft hover:text-white hover:border-red"}
      >
        Eventos
      </a>
      <a
        href="/recursos"
        data-astro-prefetch="hover"
        class="font-mono text-xs tracking-widest uppercase py-1 border-b-2 border-transparent transition-colors duration-150"
        class:list={recursosActivos ? "text-white border-red" : "text-light-soft hover:text-white hover:border-red"}
        aria-current={recursosActivos ? "page" : undefined}
      >
        Recursos
      </a>

    </nav>

    <!-- Botón burger (mobile) -->
    <button
      class="lg:hidden flex items-center justify-center w-10 h-10 text-white text-2xl cursor-pointer bg-transparent border-none"
      type="button"
      data-burger
      aria-expanded="false"
      aria-controls="menu-movil"
      aria-label="Abrir menú"
    >
      ☰
    </button>
  </div>

  <!-- Menú mobile (overlay) -->
  <nav
    id="menu-movil"
    class="mobile-nav fixed inset-0 top-16 bg-ink flex flex-col px-5 py-8 gap-6 translate-x-full transition-transform duration-300 lg:hidden z-50 overflow-y-auto"
    aria-label="Navegación móvil"
    inert
  >
    <a
      href="/"
      data-astro-prefetch="hover"
      class:list={[
        "font-mono text-sm tracking-widest uppercase py-2 border-l-2 transition-colors duration-150 pl-4",
        esActivo("/") ? "text-white border-red" : "text-light-soft hover:text-white border-transparent",
      ]}
    >
      Inicio
    </a>
    <details class="border-l-2 pl-4" class:list={federacionActiva ? "border-red" : "border-transparent"}>
      <summary class="list-none cursor-pointer font-mono text-sm tracking-widest uppercase py-2 text-light-soft">Federación <span aria-hidden="true">⌄</span></summary>
      <div class="flex flex-col gap-3 pl-4 pb-2">
        <a href="/federacion" class="text-light-soft hover:text-white font-mono text-sm tracking-wider">Quiénes somos</a>
        <a href="/escuelas" class="text-light-soft hover:text-white font-mono text-sm tracking-wider">Escuelas afiliadas</a>
      </div>
    </details>
    <a
      href="/eventos"
      data-astro-prefetch="hover"
      class:list={[
        "font-mono text-sm tracking-widest uppercase py-2 border-l-2 transition-colors duration-150 pl-4",
        esActivo("/eventos") ? "text-white border-red" : "text-light-soft hover:text-white border-transparent",
      ]}
    >
      Eventos
    </a>
    <a
      href="/recursos"
      data-astro-prefetch="hover"
      class:list={[
        "font-mono text-sm tracking-widest uppercase py-2 border-l-2 transition-colors duration-150 pl-4",
        recursosActivos ? "text-white border-red" : "text-light-soft hover:text-white border-transparent",
      ]}
      aria-current={recursosActivos ? "page" : undefined}
    >
      Recursos
    </a>
  </nav>
</header>

<script is:inline>
  function setupBurger() {
    const burger = document.querySelector('[data-burger]');
    const mobileNav = document.querySelector('.mobile-nav');
    if (!burger || !mobileNav) return;

    // Evitar doble binding en navegaciones con View Transitions
    if (burger._burgerReady) return;
    burger._burgerReady = true;

    const toggle = (open) => {
      mobileNav.classList.toggle('open', open);
      mobileNav.inert = !open;
      mobileNav.classList.toggle('translate-x-full', !open);
      mobileNav.classList.toggle('translate-x-0', open);
      burger.textContent = open ? '✕' : '☰';
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        const first = mobileNav.querySelector('a, button:not([disabled])');
        first?.focus();
      }
    };

    burger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle(!mobileNav.classList.contains('open'));
    });

    mobileNav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => toggle(false))
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav.classList.contains('open')) {
        toggle(false);
        burger.focus();
      }
    });
  }

  // Corre inmediatamente (el header ya está en el DOM)
  setupBurger();
  // Re-corre en cada navegación de View Transitions
  document.addEventListener('astro:page-load', setupBurger);
</script>
