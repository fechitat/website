---
// Botón reutilizable para mantener una jerarquía visual consistente.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'dark-ghost' | 'blue' | 'brand';
  size?: 'sm' | 'md' | 'lg' | 'icon';
  href?: string;
  /** Renderiza una etiqueta visual dentro de un enlace contenedor sin anidar enlaces. */
  as?: 'button' | 'span';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  isRounded?: boolean;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  ariaPressed?: boolean;
  ariaControls?: string;
  value?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  as = 'button',
  class: clase = '',
  type = 'button',
  disabled = false,
  isRounded = false,
  target,
  rel,
  ariaLabel,
  ariaPressed,
  ariaControls,
  value,
} = Astro.props;

const baseClasses = 'ui-button inline-flex min-h-11 items-center justify-center gap-2 px-5 py-3 font-heading text-xs font-bold uppercase tracking-wider cursor-pointer transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-itf-red disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50';

const sizeClasses = {
  sm: 'min-h-11 px-4',
  md: 'min-h-11 px-5',
  lg: 'min-h-12 px-6 text-sm',
  icon: 'min-h-9 px-2',
};

const variantClasses = {
  primary: 'bg-itf-red text-white hover:bg-itf-red-dark',
  brand: 'bg-red text-white hover:bg-red-dark',
  secondary: 'bg-slate-900 text-white hover:bg-slate-800',
  ghost: 'border border-white/70 bg-transparent text-white hover:bg-white/10',
  dark: 'bg-slate-900 text-white hover:bg-slate-800',
  'dark-ghost': 'border border-slate-300 bg-transparent text-slate-800 hover:border-slate-900 hover:bg-slate-100',
  blue: 'bg-itf-blue text-white hover:bg-itf-blue-dark',
};

const allClasses = `${baseClasses} ${isRounded ? 'rounded-lg' : 'rounded-md'} ${sizeClasses[size]} ${variantClasses[variant]} ${clase}`;
---

{href ? (
  <a href={href} class={allClasses} target={target} rel={rel} aria-label={ariaLabel}>
    <slot />
  </a>
) : as === 'span' ? (
  <span class={allClasses} aria-hidden="true">
    <slot />
  </span>
) : (
  <button type={type} class={allClasses} disabled={disabled} aria-label={ariaLabel} aria-pressed={ariaPressed} aria-controls={ariaControls} value={value}>
    <slot />
  </button>
)}
