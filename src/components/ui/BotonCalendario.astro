---
// Botón para agregar un evento al calendario (Google Calendar o iCal/Apple).
import { urlGoogleCalendar, dataUrlIcs } from "../../lib/calendario";

interface Props {
  evento: {
    titulo: string;
    fecha: string;
    fechaFin?: string;
    direccion?: string;
    ciudad?: string;
    lugar?: string;
    descripcion?: string;
  };
  className?: string;
}

const { evento, className = "" } = Astro.props;
const hrefGoogle = urlGoogleCalendar(evento);
const hrefIcs = dataUrlIcs(evento);
const nombreArchivo = `${evento.titulo.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase()}.ics`;
---

<div class:list={["inline-flex items-center rounded-sm border border-ink overflow-hidden font-mono text-xs uppercase tracking-wider", className]}>
  <a
    href={hrefGoogle}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-1.5 px-3 py-2 text-ink hover:bg-ink hover:text-white transition-colors"
    title="Agregar a Google Calendar"
  >
    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" />
    </svg>
    <span>Google Cal</span>
  </a>
  <span class="w-px h-4 bg-ink/30"></span>
  <a
    href={hrefIcs}
    download={nombreArchivo}
    class="inline-flex items-center justify-center px-2.5 py-2 text-ink hover:bg-ink hover:text-white transition-colors"
    title="Descargar archivo .ics para Apple Calendar o iPhone"
  >
    <span>Apple / iCal</span>
  </a>
</div>
