---
interface Props {
  titulo: string;
  archivo: string;
  nombreDescarga: string;
  paginas: number;
  peso: string;
}

const { titulo, archivo, nombreDescarga, paginas, peso } = Astro.props;
---

<section id="documento" class="bg-white border-b border-line" aria-labelledby="titulo-documento">
  <div class="mx-auto w-full max-w-screen-2xl px-5 py-6 md:px-8 md:py-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-red">Documento oficial</p>
        <h2 id="titulo-documento" class="mt-2 text-2xl md:text-3xl">{titulo}</h2>
        <p class="mt-2 text-sm text-text-soft">PDF · {paginas} páginas · {peso}</p>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <a href={archivo} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center justify-center border border-ink px-5 py-3 font-mono text-xs uppercase tracking-wider text-ink hover:bg-ink hover:text-white">
          Ver documento
        </a>
        <a href={archivo} download={nombreDescarga} class="inline-flex min-h-12 items-center justify-center bg-ink px-5 py-3 font-mono text-xs uppercase tracking-wider text-white hover:bg-black">
          Descargar PDF
        </a>
      </div>
    </div>
    <p class="mt-4 text-sm text-text-soft md:hidden">En el teléfono se abre con el visor del sistema. En pantalla grande queda embebido aquí.</p>
    <div class="mt-4 hidden overflow-hidden border border-line bg-paper md:block">
      <object data={archivo} type="application/pdf" class="h-[72vh] min-h-[32rem] w-full" aria-label={titulo}>
        <p class="p-6 text-text-soft">
          Este navegador no muestra el PDF aquí.
          <a href={archivo} class="font-bold text-red underline underline-offset-4" target="_blank" rel="noopener noreferrer">Ábrelo en una pestaña</a>
          o descárgalo.
        </p>
      </object>
    </div>
  </div>
</section>
