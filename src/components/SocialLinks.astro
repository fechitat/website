---
// Enlaces a redes sociales con iconos SVG reales.
// Se usa en Header y Footer.
import SocialIcon from './icons/SocialIcon.astro';

interface EnlaceSocial {
  href: string;
  icono: 'x' | 'instagram' | 'youtube' | 'facebook';
  etiqueta: string;
}

interface Props {
  class?: string;
  enlaces?: EnlaceSocial[];
  mostrarNombres?: boolean;
}

const enlacesPorDefecto: EnlaceSocial[] = [
  { href: import.meta.env.PUBLIC_FECHITAT_INSTAGRAM, icono: 'instagram', etiqueta: 'Instagram' },
  { href: import.meta.env.PUBLIC_FECHITAT_FACEBOOK, icono: 'facebook', etiqueta: 'Facebook' },
  { href: import.meta.env.PUBLIC_FECHITAT_YOUTUBE, icono: 'youtube', etiqueta: 'YouTube' },
].filter((enlace) => typeof enlace.href === 'string' && /^https:\/\//.test(enlace.href));

const {
  class: clase = 'flex gap-3 items-center',
  enlaces = enlacesPorDefecto,
  mostrarNombres = false,
} = Astro.props;
---

{enlaces.length > 0 && <div class={clase}>
  {
    enlaces.map((enlace) => (
      <a
        href={enlace.href}
        aria-label={enlace.etiqueta}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-light-soft transition-colors duration-150 hover:text-white"
      >
        <SocialIcon name={enlace.icono} size={15} class="shrink-0" />
        {mostrarNombres && <span>{enlace.etiqueta}</span>}
      </a>
    ))
  }
</div>}
