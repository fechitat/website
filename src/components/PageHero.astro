---
interface Props {
  title: string;
  description?: string;
  crumb?: string;
  crumbHref?: string;
  image?: string;
  imageAlt?: string;
  imageStyle?: string;
}

const { title, description, crumb, crumbHref, image, imageAlt, imageStyle } = Astro.props;
---

<section class="bg-ink text-white py-10 md:py-14 pb-8 md:pb-10">
  <div
    class:list={[
      'max-w-6xl mx-auto px-5 md:px-7',
      image ? 'grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-center' : '',
    ]}
  >
    <div>
      {crumb && (
        <nav aria-label="Ruta de navegación" class="font-mono text-xs tracking-wider uppercase text-light-muted mb-4">
          <a href="/" class="hover:text-white transition-colors duration-150">Inicio</a> /
          {crumbHref ? <a href={crumbHref} class="hover:text-white transition-colors duration-150">{crumb}</a> : <span>{crumb}</span>}
        </nav>
      )}
      <h1 class="page-hero-title text-white uppercase">{title.split(/<br\s*\/?>/i).map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>
      {description && <p class="text-light-soft max-w-3xl mt-2">{description}</p>}
      <slot />
    </div>
    {image && <img src={image} alt={imageAlt ?? ''} style={imageStyle} class="rounded-sm w-full" />}
  </div>
</section>

<style>
  .page-hero-title {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
  }
</style>
