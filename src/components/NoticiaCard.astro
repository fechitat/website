---
import type { PublicBlogPost } from '../lib/blog';

interface Props {
  post: PublicBlogPost;
}

const { post } = Astro.props;
const href = `/blog/${encodeURIComponent(post.slug.current)}`;
const etiquetas: Record<string, string> = {
  noticias: 'Noticias', tecnica: 'Técnica', entrevistas: 'Entrevistas', historia: 'Historia', arbitraje: 'Arbitraje',
};
const categoria = post.categorias?.find((valor) => valor && valor !== 'eventos') ?? 'noticias';
const fechaValida = post.fecha && !Number.isNaN(Date.parse(post.fecha)) ? post.fecha : undefined;
const fecha = fechaValida
  ? new Date(fechaValida).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' })
  : undefined;
---

<a href={href} class="noticia-card group flex h-full flex-col rounded-xl overflow-hidden border border-slate-200 bg-white hover:border-blue hover:shadow-md transition-all duration-200 shadow-xs">
  {post.imagenUrl && (
    <img src={post.imagenUrl} alt={post.imagenAlt || ''} class="aspect-[16/10] w-full object-cover" loading="lazy" decoding="async" />
  )}
  <div class="flex h-full flex-col p-5">
    <div class="mb-3 flex items-center justify-between gap-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-bold uppercase tracking-wider bg-blue/10 text-blue border border-blue/20">
        {etiquetas[categoria] ?? categoria}
      </span>
      {fecha && <time datetime={fechaValida} class="text-xs text-text-soft">{fecha}</time>}
    </div>
    <h3 class="mb-0 text-lg sm:text-xl font-bold font-heading leading-snug text-ink group-hover:text-blue transition-colors">{post.titulo}</h3>
    {post.extracto && <p class="mt-2 mb-0 line-clamp-3 text-sm leading-relaxed text-text-soft">{post.extracto}</p>}
    <span class="mt-auto pt-5 text-sm font-bold text-blue flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Leer noticia ➔
    </span>
  </div>
</a>

<style>
  .noticia-card:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 3px;
  }
</style>
