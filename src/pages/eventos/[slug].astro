---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import UIcon from '../../components/icons/UIcon.astro';
import Button from '../../components/ui/Button.astro';
import { getEventoBySlug } from '../../lib/sanityQueries';
import { urlFor } from '../../lib/sanity';

const slug = Astro.params.slug;
const evento = slug ? await getEventoBySlug(slug) : null;

if (!evento) {
  return Astro.redirect('/eventos');
}

const fotos = evento.galeria ?? [];
const fotosConUrl = fotos.map((foto, indice) => ({
  alt: foto.alt || `${evento.titulo} — foto ${indice + 1}`,
  miniatura: urlFor(foto).width(480).height(480).fit('crop').auto('format').quality(75).url(),
  original: urlFor(foto).width(1400).auto('format').quality(80).url(),
}));

const labelTipo = (tipo: string) => {
  if (tipo === 'competencia') return 'Competencia';
  if (tipo === 'examen') return 'Examen';
  if (tipo === 'seminario') return 'Seminario';
  if (tipo === 'exhibicion') return 'Exhibición';
  return 'Otro';
};

const fecha = new Date(evento.fecha).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const imagenUrl = evento.flyer ? urlFor(evento.flyer).width(1200).url() : undefined;
const jsonLdEvento = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: evento.titulo,
  startDate: evento.fecha,
  ...(evento.fechaFin ? { endDate: evento.fechaFin } : {}),
  ...(imagenUrl ? { image: imagenUrl } : {}),
  ...(evento.descripcion ? { description: evento.descripcion } : {}),
  ...(evento.lugar || evento.ciudad
    ? {
        location: {
          '@type': 'Place',
          name: evento.lugar ?? evento.ciudad,
          address: {
            '@type': 'PostalAddress',
            addressLocality: evento.ciudad ?? '',
            addressCountry: 'CL',
          },
        },
      }
    : {}),
  organizer: { '@type': 'SportsOrganization', name: 'FECHITAT', url: 'https://fechitat-website.vercel.app' },
};
---

<BaseLayout
  title={`${evento.titulo} — Eventos`}
  description={evento.descripcion ?? `${evento.titulo}: fecha, lugar y detalles del evento de FECHITAT.`}
  ogImage={imagenUrl}
  structuredData={jsonLdEvento}
>
  <PageHero
    title={evento.titulo}
    crumb="Eventos"
    image={evento.flyer ? urlFor(evento.flyer).width(600).auto('format').quality(75).url() : undefined}
    imageAlt={`Flyer de ${evento.titulo}`}
    imageStyle="object-fit:contain;max-height:24rem"
  />

  <article class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <Button href="/eventos" variant="secondary" size="sm" class="mb-8">
        <UIcon name="arrow-left" size={16} />
        Volver a eventos
      </Button>

      <div class="flex flex-wrap items-center gap-3 mb-8">
        <span class="font-mono text-xs tracking-wider uppercase text-text-soft">{labelTipo(evento.tipo)}</span>
        <span class="font-mono text-xs tracking-wider text-text-soft">
          {fecha}
          {evento.fechaFin && (
            <> – {new Date(evento.fechaFin).toLocaleDateString('es-CL', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}</>
          )}
        </span>
        {evento.lugar && <span class="font-mono text-xs tracking-wider text-text-soft">{evento.lugar}</span>}
      </div>

      {evento.descripcion && <p class="text-text-soft mb-10">{evento.descripcion}</p>}

      {fotosConUrl.length > 0 && (
        <section aria-labelledby="galeria-titulo">
          <div class="flex items-end justify-between gap-4 mb-5">
            <h2 id="galeria-titulo">Galería de fotos</h2>
            <span class="font-mono text-xs text-text-soft">{fotosConUrl.length} fotos</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
            {fotosConUrl.map((foto, indice) => (
              <button
                type="button"
                class="relative block w-full aspect-square bg-slate-200 rounded-sm overflow-hidden cursor-zoom-in p-0 border-none"
                data-galeria-boton={indice}
                aria-label={`Ver foto en tamaño completo`}
              >
                <span class="absolute inset-0 bg-slate-200 animate-pulse" data-esqueleto aria-hidden="true"></span>
                <img src={foto.miniatura} alt={foto.alt} width="480" height="480" loading="lazy" decoding="async"
                  class="relative w-full h-full object-cover opacity-0 transition-opacity duration-300"
                  data-miniatura />
              </button>
            ))}
          </div>
        </section>
      )}

      <dialog id="galeria-dialogo" class="m-auto w-fit max-w-[96vw] max-h-[92vh] overflow-visible bg-ink p-2 rounded-sm border-none">
        <div class="relative flex items-center justify-center touch-pan-y">
          <button
            type="button"
            id="galeria-cerrar"
            class="absolute -top-3 -right-3 z-20 w-9 h-9 bg-red text-white rounded-full flex items-center justify-center cursor-pointer border-none text-base"
            aria-label="Cerrar galería"
          >
            ✕
          </button>
          <button type="button" id="galeria-anterior" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 w-11 h-11 rounded-full bg-black/70 text-white text-2xl flex items-center justify-center border border-white/30 hover:bg-black" aria-label="Ver fotografía anterior">‹</button>
          <div id="galeria-cargando" class="min-w-48 w-[80vw] max-w-2xl h-[60vh] bg-slate-700 animate-pulse flex items-center justify-center text-white text-sm" role="status">Cargando fotografía…</div>
          <img id="galeria-imagen" alt="" draggable="false" class="hidden max-w-[92vw] max-h-[82vh] object-contain rounded-sm select-none" />
          <button type="button" id="galeria-siguiente" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 w-11 h-11 rounded-full bg-black/70 text-white text-2xl flex items-center justify-center border border-white/30 hover:bg-black" aria-label="Ver fotografía siguiente">›</button>
        </div>
        <p id="galeria-contador" class="m-0 pt-2 text-center text-xs text-white/80" aria-live="polite"></p>
      </dialog>
    </div>
  </article>
  <script define:vars={{ fotos: fotosConUrl }}>
    const dialogo = document.getElementById('galeria-dialogo');
    const imagen = document.getElementById('galeria-imagen');
    const botones = document.querySelectorAll('[data-galeria-boton]');
    const cerrar = document.getElementById('galeria-cerrar');
    const anterior = document.getElementById('galeria-anterior');
    const siguiente = document.getElementById('galeria-siguiente');
    const contador = document.getElementById('galeria-contador');
    const cargando = document.getElementById('galeria-cargando');

    document.querySelectorAll('[data-miniatura]').forEach((miniatura) => {
      const terminar = () => {
        miniatura.classList.remove('opacity-0');
        miniatura.parentElement?.querySelector('[data-esqueleto]')?.remove();
      };
      if (miniatura.complete) terminar();
      else {
        miniatura.addEventListener('load', terminar, { once: true });
        miniatura.addEventListener('error', terminar, { once: true });
      }
    });

    imagen?.addEventListener('load', () => {
      cargando?.classList.add('hidden');
      imagen.classList.remove('hidden');
    });
    imagen?.addEventListener('error', () => {
      if (cargando) {
        cargando.textContent = 'No se pudo cargar la fotografía.';
        cargando.classList.remove('animate-pulse');
      }
    });

    if (dialogo && imagen && botones.length && cerrar && anterior && siguiente) {
      let indiceActual = 0;
      const mostrarFoto = (indice) => {
        indiceActual = (indice + fotos.length) % fotos.length;
        const foto = fotos[indiceActual];
        if (!foto) return;
        imagen.classList.add('hidden');
        if (cargando) {
          cargando.textContent = 'Cargando fotografía…';
          cargando.classList.remove('hidden');
          cargando.classList.add('animate-pulse');
        }
        if (contador) contador.textContent = `${indiceActual + 1} / ${fotos.length}`;
        imagen.src = foto.original;
        imagen.alt = foto.alt;
      };

      botones.forEach((boton) => {
        boton.addEventListener('click', () => {
          mostrarFoto(Number(boton.dataset.galeriaBoton));
          if (!dialogo.open) dialogo.showModal();
        });
      });

      anterior.addEventListener('click', () => mostrarFoto(indiceActual - 1));
      siguiente.addEventListener('click', () => mostrarFoto(indiceActual + 1));
      cerrar.addEventListener('click', () => dialogo.close());

      let inicioX = null;
      const superficie = imagen.parentElement;
      superficie?.addEventListener('pointerdown', (evento) => {
        if (evento.target === imagen) {
          inicioX = evento.clientX;
          superficie.setPointerCapture(evento.pointerId);
        }
      });
      superficie?.addEventListener('pointerup', (evento) => {
        if (inicioX === null) return;
        const desplazamiento = evento.clientX - inicioX;
        inicioX = null;
        if (Math.abs(desplazamiento) < 45) return;
        mostrarFoto(desplazamiento < 0 ? indiceActual + 1 : indiceActual - 1);
      });
      superficie?.addEventListener('pointercancel', () => { inicioX = null; });

      dialogo.addEventListener('click', (eventoClick) => {
        if (eventoClick.target === dialogo) dialogo.close();
      });

      document.addEventListener('keydown', (eventoTeclado) => {
        if (!dialogo.open) return;
        if (eventoTeclado.key === 'ArrowLeft') {
          eventoTeclado.preventDefault();
          mostrarFoto(indiceActual - 1);
        } else if (eventoTeclado.key === 'ArrowRight') {
          eventoTeclado.preventDefault();
          mostrarFoto(indiceActual + 1);
        } else if (eventoTeclado.key === 'Escape') {
          dialogo.close();
        }
      });
    }
  </script>
</BaseLayout>
