---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PATRONES } from '../../../features/temporizador/patrones';

export const prerender = true;

const titulo = 'Temporizador de formas — FECHITAT';
const descripcion = 'Cronómetro oficial de Tuls con límites reglamentarios ITF.';
const formaInicial = PATRONES[0];
---

<BaseLayout title={titulo} description={descripcion} mostrarFooter={false}>
  <div class="bg-white border-b border-line py-4 md:py-5">
    <div class="mx-auto w-full max-w-lg px-4 md:px-6 text-center">
      <h1 class="text-2xl sm:text-3xl font-extrabold font-heading text-ink tracking-tight m-0">Temporizador</h1>
    </div>
  </div>

  <section class="bg-white py-6 md:py-8 min-h-[calc(100dvh-5.5rem)] flex flex-col">
    <div class="mx-auto w-full max-w-lg px-4 md:px-6 my-auto">
      <div id="temporizador-formas" class="space-y-5">
        <!-- Selector desplegable de formas en orden oficial -->
        <div>
          <label for="selector-forma" class="block text-xs font-mono font-bold uppercase tracking-wider text-text-soft mb-2 text-center">Selecciona la forma</label>
          <select
            id="selector-forma"
            data-select-forma
            class="w-full min-h-12 border border-line bg-white px-4 py-2.5 text-base font-bold text-ink rounded-xl shadow-2xs focus-visible:outline-2 focus-visible:outline-red cursor-pointer text-center"
          >
            {PATRONES.map((patron) => (
              <option value={patron.id}>
                {patron.nombre} ({patron.grado}) — {patron.limiteSegundos}s
              </option>
            ))}
          </select>
        </div>

        <section data-panel aria-labelledby="forma-activa" class="border border-line rounded-2xl bg-white p-6 md:p-8 shadow-xs text-center flex flex-col items-center">
          <p data-grado class="font-mono text-xs uppercase tracking-widest text-red font-bold mb-1 text-center">
            {formaInicial?.grado ?? '9° a 8° Gup'}
          </p>
          <h2 id="forma-activa" data-nombre class="text-3xl md:text-4xl font-extrabold font-heading text-ink tracking-tight m-0 text-center">
            {formaInicial?.nombre ?? 'Chon-Ji'}
          </h2>
          <p class="my-4 font-mono text-[clamp(3.5rem,14vw,5.5rem)] leading-none font-bold text-ink text-center tracking-tight" data-limite aria-hidden="true">
            01:00.00
          </p>

          <fieldset class="mt-4 border-0 p-0 w-full max-w-sm">
            <legend class="mb-2 text-xs font-mono font-bold uppercase tracking-wider text-text-soft text-center">Retraso de inicio</legend>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" data-retraso="0" aria-pressed="false" class="opcion min-h-11 rounded-lg border border-line font-mono font-bold text-sm cursor-pointer">Sin espera</button>
              <button type="button" data-retraso="3" aria-pressed="true" class="opcion is-activo min-h-11 rounded-lg border border-line font-mono font-bold text-sm cursor-pointer">3 Seg</button>
              <button type="button" data-retraso="10" aria-pressed="false" class="opcion min-h-11 rounded-lg border border-line font-mono font-bold text-sm cursor-pointer">10 Seg</button>
            </div>
          </fieldset>

          <fieldset class="mt-4 border-0 p-0 w-full max-w-sm">
            <legend class="mb-2 text-xs font-mono font-bold uppercase tracking-wider text-text-soft text-center">Metrónomo de ritmo</legend>
            <div class="grid grid-cols-2 gap-2" role="group" aria-label="Metrónomo">
              <button type="button" data-metronomo="si" aria-pressed="true" class="opcion is-activo min-h-11 rounded-lg border border-line font-mono font-bold text-sm cursor-pointer">Activado</button>
              <button type="button" data-metronomo="no" aria-pressed="false" class="opcion min-h-11 rounded-lg border border-line font-mono font-bold text-sm cursor-pointer">Desactivado</button>
            </div>
          </fieldset>

          <label class="mt-4 flex min-h-11 items-center justify-center gap-3 text-sm font-medium cursor-pointer">
            <input data-sonido type="checkbox" checked class="h-5 w-5 accent-red rounded cursor-pointer" />
            Efectos sonoros y beeps
          </label>
          <button type="button" data-iniciar class="mt-4 min-h-14 w-full max-w-sm rounded-xl bg-red px-5 text-base font-bold uppercase tracking-wider text-white hover:bg-red-dark transition-all shadow-md active:scale-98 cursor-pointer">Comenzar</button>
        </section>

        <!-- Overlay de cronómetro a pantalla completa -->
        <div data-overlay hidden class="overlay" role="dialog" aria-modal="true" aria-labelledby="overlay-nombre">
          <button
            type="button"
            data-pantalla-completa
            aria-label="Alternar pantalla completa"
            title="Pantalla completa"
            class="absolute top-5 right-5 z-20 inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/20 bg-white/10 hover:bg-white/20 text-white transition-all active:scale-95 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
            </svg>
          </button>

          <p id="overlay-nombre" data-overlay-nombre class="font-mono text-xs uppercase tracking-widest text-white/80 text-center"></p>
          <div data-reloj class="reloj" style="--progreso: 0">
            <div class="reloj-centro">
              <span data-pulso class="pulso" aria-hidden="true"></span>
              <p data-tiempo class="tiempo">00:00.00</p>
              <p data-estado class="text-sm">Prepárate</p>
            </div>
          </div>
          <p data-movimiento class="text-center text-base font-bold text-white"></p>
          <p data-anuncio class="sr-only" aria-live="polite"></p>
          <div class="mt-6 grid w-full max-w-md grid-cols-2 gap-3">
            <button type="button" data-pausar class="min-h-14 border border-white text-base font-bold rounded-xl hover:bg-white/10 transition-colors cursor-pointer">Pausar</button>
            <button type="button" data-detener class="min-h-14 bg-white text-base font-bold text-ink rounded-xl hover:bg-white/90 transition-colors cursor-pointer">Detener</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { iniciarTemporizador } from '../../../features/temporizador/controlador.ts';

  function montar(): void {
    const raiz = document.getElementById('temporizador-formas');
    if (!raiz) return;
    iniciarTemporizador(raiz);
  }

  montar();
  document.addEventListener('astro:page-load', montar);
</script>

<style>
  .temporizador-layout { display: grid; gap: 1.25rem; }
  .lista-formas { min-width: 0; }
  .lista-formas.is-colapsada { margin-bottom: 0; }
  .forma[aria-pressed="true"] { border-color: var(--color-ink); background: var(--color-ink); color: white; }
  .forma[aria-pressed="true"] span { color: white; }
  .filtro[aria-pressed="true"] { border-color: var(--color-ink); background: var(--color-ink); color: white; }
  .opcion.is-activo { border-color: var(--color-ink); background: var(--color-ink); color: white; }
  .overlay {
    position: fixed; inset: 0; z-index: 60; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem; padding: max(1rem, env(safe-area-inset-top)) 1rem max(1rem, env(safe-area-inset-bottom));
    background: var(--color-ink); color: white;
  }
  .overlay[hidden] { display: none; }
  .reloj {
    width: min(78vw, 22rem); aspect-ratio: 1; border-radius: 999px; display: grid; place-items: center;
    background: conic-gradient(var(--color-red) calc(var(--progreso) * 360deg), #243044 0);
  }
  .reloj-centro {
    width: 78%; aspect-ratio: 1; border-radius: 999px; background: var(--color-ink);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem;
  }
  .tiempo { font-family: var(--font-mono); font-size: clamp(2.6rem, 12vw, 4.5rem); font-weight: 800; line-height: 1; }
  .tiempo.is-excedido { color: #ffb4b4; }
  .pulso { width: 0.8rem; height: 0.8rem; border-radius: 999px; background: white; }
  .pulso.is-pulso { animation: pulso 180ms ease-out; }
  @keyframes pulso { from { transform: scale(1.8); background: var(--color-red); } to { transform: scale(1); } }
  @media (min-width: 768px) {
    .temporizador-layout { grid-template-columns: minmax(18rem, 24rem) minmax(0, 1fr); align-items: start; }
    .lista-formas { position: sticky; top: 5.5rem; max-height: calc(100vh - 7rem); overflow: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulso.is-pulso { animation: none; background: var(--color-red); }
  }
</style>
