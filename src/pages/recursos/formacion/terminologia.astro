---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import UIcon from '../../../components/icons/UIcon.astro';

export const prerender = true;

const terminos = [
  // General
  { coreano: '태권도', romanizacion: 'Taekwon-Do', espanol: 'Arte marcial de pies y puños', ingles: 'The way of foot and fist', categoria: 'General' },
  { coreano: '국기', romanizacion: 'Ku (Gukgi)', espanol: 'Bandera nacional', ingles: 'National flag', categoria: 'General' },
  { coreano: '틀', romanizacion: 'Tul', espanol: 'Forma o patrón', ingles: 'Pattern', categoria: 'General' },
  { coreano: '도장', romanizacion: 'Dojang', espanol: 'Lugar de entrenamiento', ingles: 'Training hall', categoria: 'General' },
  { coreano: '도복', romanizacion: 'Dobok', espanol: 'Traje de entrenamiento', ingles: 'Training suit', categoria: 'General' },
  { coreano: '띠', romanizacion: 'Ti', espanol: 'Cinturón', ingles: 'Belt', categoria: 'General' },
  { coreano: '사범', romanizacion: 'Sabum', espanol: 'Instructor (IV a VI Dan)', ingles: 'Instructor', categoria: 'General' },
  { coreano: '사현', romanizacion: 'Sahyun', espanol: 'Maestro (VII y VIII Dan)', ingles: 'Master', categoria: 'General' },
  { coreano: '사성', romanizacion: 'Sasung', espanol: 'Gran Maestro (IX Dan)', ingles: 'Grand Master', categoria: 'General' },
  { coreano: '급', romanizacion: 'Gup', espanol: 'Grado de cinturón de color', ingles: 'Colour-belt rank', categoria: 'Grados' },
  { coreano: '단', romanizacion: 'Dan', espanol: 'Grado de cinturón negro', ingles: 'Black-belt degree', categoria: 'Grados' },

  // Comandos
  { coreano: '차렷', romanizacion: 'Charyot', espanol: 'Atención / Firmes', ingles: 'Attention', categoria: 'Comandos' },
  { coreano: '경례', romanizacion: 'Kyong Ye', espanol: 'Saludo de cortesía', ingles: 'Bow', categoria: 'Comandos' },
  { coreano: '준비', romanizacion: 'Junbi', espanol: 'Listo / En guardia', ingles: 'Ready', categoria: 'Comandos' },
  { coreano: '시작', romanizacion: 'Sijak', espanol: 'Comenzar', ingles: 'Begin / Start', categoria: 'Comandos' },
  { coreano: '그만', romanizacion: 'Goman', espanol: 'Detenerse / Alto', ingles: 'Stop', categoria: 'Comandos' },
  { coreano: '쉬어', romanizacion: 'Swiyo', espanol: 'Descanso', ingles: 'Relax / At ease', categoria: 'Comandos' },
  { coreano: '해산', romanizacion: 'Haesan', espanol: 'Rompan filas / Salir', ingles: 'Dismiss', categoria: 'Comandos' },

  // Posiciones (Sogi)
  { coreano: '서기', romanizacion: 'Sogi', espanol: 'Posición', ingles: 'Stance', categoria: 'Posiciones' },
  { coreano: '차렷서기', romanizacion: 'Charyot Sogi', espanol: 'Posición de atención', ingles: 'Attention stance', categoria: 'Posiciones' },
  { coreano: '나란히서기', romanizacion: 'Narani Sogi', espanol: 'Posición de pies paralelos', ingles: 'Parallel stance', categoria: 'Posiciones' },
  { coreano: '건눈서기', romanizacion: 'Gunnun Sogi', espanol: 'Posición de caminar', ingles: 'Walking stance', categoria: 'Posiciones' },
  { coreano: '니은자서기', romanizacion: 'Niunja Sogi', espanol: 'Posición en L', ingles: 'L-stance', categoria: 'Posiciones' },
  { coreano: '앉은서기', romanizacion: 'Annun Sogi', espanol: 'Posición de jinete', ingles: 'Sitting stance', categoria: 'Posiciones' },
  { coreano: '고정서기', romanizacion: 'Gojung Sogi', espanol: 'Posición en L larga / fija', ingles: 'Fixed stance', categoria: 'Posiciones' },
  { coreano: '교차서기', romanizacion: 'Kyocha Sogi', espanol: 'Posición de pies cruzados', ingles: 'X-stance', categoria: 'Posiciones' },

  // Técnicas (Ataques y Defensas)
  { coreano: '지르기', romanizacion: 'Jirugi', espanol: 'Golpe de puño', ingles: 'Punch', categoria: 'Técnica' },
  { coreano: '막기', romanizacion: 'Makgi', espanol: 'Defensa o bloqueo', ingles: 'Block', categoria: 'Técnica' },
  { coreano: '차기', romanizacion: 'Chagi', espanol: 'Patada', ingles: 'Kick', categoria: 'Técnica' },
  { coreano: '앞차기', romanizacion: 'Ap Chagi', espanol: 'Patada frontal', ingles: 'Front kick', categoria: 'Técnica' },
  { coreano: '돌려차기', romanizacion: 'Dollyo Chagi', espanol: 'Patada circular', ingles: 'Turning kick', categoria: 'Técnica' },
  { coreano: '옆차기', romanizacion: 'Yop Chagi', espanol: 'Patada lateral', ingles: 'Side kick', categoria: 'Técnica' },
  { coreano: '반대돌려차기', romanizacion: 'Bandae Dollyo Chagi', espanol: 'Patada con giro talón', ingles: 'Reverse turning kick', categoria: 'Técnica' },
  { coreano: '내려차기', romanizacion: 'Naeryo Chagi', espanol: 'Patada descendente', ingles: 'Downward kick', categoria: 'Técnica' },
  { coreano: '손칼', romanizacion: 'Sonkal', espanol: 'Canto de la mano', ingles: 'Knife-hand', categoria: 'Técnica' },
  { coreano: '팔목', romanizacion: 'Palmok', espanol: 'Antebrazo', ingles: 'Forearm', categoria: 'Técnica' },
  { coreano: '맞서기', romanizacion: 'Matsokgi', espanol: 'Combate', ingles: 'Sparring', categoria: 'Técnica' },
  { coreano: '위력', romanizacion: 'Wiryok', espanol: 'Rotura de poder', ingles: 'Power breaking', categoria: 'Técnica' },

  // Números
  { coreano: '하나', romanizacion: 'Hana', espanol: 'Uno (1)', ingles: 'One', categoria: 'Números' },
  { coreano: '둘', romanizacion: 'Dul', espanol: 'Dos (2)', ingles: 'Two', categoria: 'Números' },
  { coreano: '셋', romanizacion: 'Set', espanol: 'Tres (3)', ingles: 'Three', categoria: 'Números' },
  { coreano: '넷', romanizacion: 'Net', espanol: 'Cuatro (4)', ingles: 'Four', categoria: 'Números' },
  { coreano: '다섯', romanizacion: 'Dasot', espanol: 'Cinco (5)', ingles: 'Five', categoria: 'Números' },
  { coreano: '여섯', romanizacion: 'Yosot', espanol: 'Seis (6)', ingles: 'Six', categoria: 'Números' },
  { coreano: '일곱', romanizacion: 'Ilgop', espanol: 'Siete (7)', ingles: 'Seven', categoria: 'Números' },
  { coreano: '여덟', romanizacion: 'Yodol', espanol: 'Ocho (8)', ingles: 'Eight', categoria: 'Números' },
  { coreano: '아홉', romanizacion: 'Ahop', espanol: 'Nueve (9)', ingles: 'Nine', categoria: 'Números' },
  { coreano: '열', romanizacion: 'Yol', espanol: 'Diez (10)', ingles: 'Ten', categoria: 'Números' },

  // Zonas del cuerpo
  { coreano: '높은데', romanizacion: 'Nopunde', espanol: 'Zona alta (cuello hacia arriba)', ingles: 'High section', categoria: 'Zonas' },
  { coreano: '가운데', romanizacion: 'Kaunde', espanol: 'Zona media (hombros al ombligo)', ingles: 'Middle section', categoria: 'Zonas' },
  { coreano: '낮은데', romanizacion: 'Najunde', espanol: 'Zona baja (ombligo hacia abajo)', ingles: 'Low section', categoria: 'Zonas' },
];

const categorias = ['Todos', 'Comandos', 'Posiciones', 'Técnica', 'Grados', 'Números', 'Zonas', 'General'];
---

<BaseLayout title="Glosario — FECHITAT" description="Diccionario interactivo de Taekwon-Do ITF en español, inglés y coreano con pronunciación nativa en audio." mostrarFooter={false}>
  <div class="bg-white border-b border-line py-5 md:py-6">
    <div class="max-w-6xl mx-auto px-5 md:px-7">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-heading text-ink tracking-tight m-0">Glosario</h1>
    </div>
  </div>

  <section class="max-w-6xl mx-auto px-5 md:px-7 py-6 md:py-10">
    <!-- Controles de búsqueda y filtros -->
    <div class="mb-6 flex flex-col gap-4">
      <div>
        <label for="buscar-termino" class="block text-sm font-bold text-ink mb-2">Buscar término</label>
        <div class="relative max-w-xl">
          <span class="absolute inset-y-0 left-4 flex items-center text-text-soft pointer-events-none">
            <UIcon name="search" size={18} />
          </span>
          <input
            id="buscar-termino"
            type="search"
            placeholder="Escribe en español, inglés o coreano (ej. patada, sogi, chagi...)"
            class="w-full border border-line bg-white pl-11 pr-4 py-3 text-ink text-sm sm:text-base rounded-lg focus-visible:outline-2 focus-visible:outline-red shadow-2xs"
          />
        </div>
      </div>

      <!-- Barra de categorías deslizables -->
      <nav aria-label="Filtrar términos por categoría" class="overflow-x-auto pb-1 scrollbar-none flex gap-2">
        {categorias.map((cat, i) => (
          <button
            type="button"
            data-filtro-cat={cat === 'Todos' ? '' : cat}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class:list={[
              'filtro-cat-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer',
              i === 0
                ? 'bg-ink text-white border-ink'
                : 'bg-white text-text-soft border-line hover:border-ink hover:text-ink',
            ]}
          >
            {cat}
          </button>
        ))}
      </nav>
    </div>

    <!-- Lista de términos en tarjetas compactas con desplegable nativo y carga progresiva -->
    <div id="terminos-diccionario" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {terminos.map((termino, indice) => (
        <details
          class:list={[
            'tarjeta-termino group bg-white border border-line rounded-xl p-3.5 sm:p-4 shadow-2xs hover:border-ink/20 transition-all',
            indice >= 15 ? 'hidden' : '',
          ]}
          data-indice={indice}
          data-termino={`${termino.coreano} ${termino.romanizacion} ${termino.espanol} ${termino.ingles} ${termino.categoria}`.toLocaleLowerCase()}
          data-cat={termino.categoria}
        >
          <summary class="flex items-start justify-between gap-2.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
            <div class="min-w-0">
              <span lang="ko" class="text-base sm:text-lg font-bold text-ink block leading-tight">
                {termino.coreano}
              </span>
              <span class="block text-xs font-mono text-text-soft mt-0.5">
                {termino.romanizacion}
              </span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                data-pronunciar={termino.coreano}
                data-nombre={termino.romanizacion}
                aria-label={`Pronunciar ${termino.romanizacion} en coreano`}
                title={`Escuchar pronunciación de ${termino.romanizacion}`}
                class="audio-speak-btn inline-flex items-center justify-center w-8 h-8 rounded-full border border-line bg-paper/60 hover:bg-paper text-text-soft hover:text-red transition-all active:scale-90 focus-visible:outline-2 focus-visible:outline-red cursor-pointer"
              >
                <UIcon name="volume-2" size={15} />
              </button>
              <span
                aria-hidden="true"
                class="toggle-desplegar-btn inline-flex items-center justify-center w-8 h-8 rounded-full border border-line bg-paper/60 text-text-soft group-hover:text-ink transition-all"
              >
                <UIcon name="chevron-down" size={15} class="transition-transform duration-200 group-open:rotate-180" />
              </span>
            </div>
          </summary>

          <!-- Traducción desplegable abajo -->
          <div class="mt-3 pt-2.5 border-t border-line text-sm animate-in fade-in duration-150">
            <p class="font-medium text-ink m-0 leading-snug">
              {termino.espanol}
            </p>
            {termino.ingles && (
              <p class="text-xs text-text-soft m-0 mt-1 leading-snug" lang="en">
                {termino.ingles}
              </p>
            )}
          </div>
        </details>
      ))}
    </div>

    <!-- Centinela para scroll asíncrono -->
    <div id="scroll-centinela" class="h-10 flex items-center justify-center mt-4"></div>

    <p id="sin-resultados" hidden class="p-8 text-center border border-dashed border-line rounded-xl bg-white text-text-soft mt-4">
      No se encontraron términos para esta búsqueda.
    </p>
  </section>

  <script>
    function setupGlosario() {
      const contenedor = document.getElementById('terminos-diccionario');
      const buscador = document.getElementById('buscar-termino') as HTMLInputElement | null;
      const sinResultados = document.getElementById('sin-resultados');
      const filtroBotones = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro-cat]')];
      const centinela = document.getElementById('scroll-centinela');
      if (!contenedor) return;

      const tarjetas = [...contenedor.querySelectorAll<HTMLDetailsElement>('.tarjeta-termino')];
      let categoriaActiva = '';
      const TAMANO_LOTE = 15;
      let cantidadVisible = TAMANO_LOTE;

      // Cargar más palabras asíncronamente con scroll
      const cargarMas = () => {
        const consulta = (buscador?.value || '').trim().toLocaleLowerCase();
        if (consulta || categoriaActiva) return;

        cantidadVisible = Math.min(tarjetas.length, cantidadVisible + TAMANO_LOTE);

        tarjetas.forEach((tarjeta, i) => {
          if (i < cantidadVisible) {
            tarjeta.classList.remove('hidden');
          }
        });

        if (cantidadVisible >= tarjetas.length && observer) {
          observer.disconnect();
        }
      };

      let observer: IntersectionObserver | null = null;
      if (centinela && 'IntersectionObserver' in window) {
        observer = new IntersectionObserver((entries) => {
          if (entries[0]?.isIntersecting) {
            cargarMas();
          }
        }, { rootMargin: '300px' });
        observer.observe(centinela);
      }

      // Síntesis de voz nativa en Coreano (ko-KR)
      const reproducirCoreano = (texto: string, boton: HTMLElement) => {
        if (!('speechSynthesis' in window)) {
          alert('Tu navegador no soporta síntesis de voz.');
          return;
        }

        try {
          window.speechSynthesis.cancel();
        } catch {}

        const utterance = new SpeechSynthesisUtterance(texto);
        utterance.lang = 'ko-KR';
        utterance.rate = 0.82;
        utterance.pitch = 1.0;

        boton.classList.add('text-red', 'bg-red/20', 'scale-110');
        utterance.onend = () => boton.classList.remove('text-red', 'bg-red/20', 'scale-110');
        utterance.onerror = () => boton.classList.remove('text-red', 'bg-red/20', 'scale-110');

        window.setTimeout(() => {
          window.speechSynthesis.speak(utterance);
        }, 40);
      };

      // Delegación de click para botón de pronunciación (sin disparar el summary de details)
      contenedor.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btnAudio = target?.closest<HTMLButtonElement>('[data-pronunciar]');
        if (btnAudio) {
          e.preventDefault();
          e.stopPropagation();
          const coreano = btnAudio.dataset.pronunciar;
          if (coreano) reproducirCoreano(coreano, btnAudio);
        }
      });

      // Filtro reactivo por texto y categoría
      const aplicarFiltros = () => {
        const consulta = (buscador?.value || '').trim().toLocaleLowerCase();
        let visibles = 0;

        tarjetas.forEach((tarjeta, index) => {
          const coincideTexto = !consulta || (tarjeta.dataset.termino || '').includes(consulta);
          const coincideCat = !categoriaActiva || tarjeta.dataset.cat === categoriaActiva;
          const coincide = coincideTexto && coincideCat;

          if (consulta || categoriaActiva) {
            tarjeta.classList.toggle('hidden', !coincide);
          } else {
            const dentroDelLote = index < cantidadVisible;
            tarjeta.classList.toggle('hidden', !dentroDelLote);
          }

          if (coincide && (consulta || categoriaActiva || index < cantidadVisible)) {
            visibles++;
          }
        });

        if (sinResultados) {
          sinResultados.hidden = visibles > 0;
        }
      };

      buscador?.addEventListener('input', aplicarFiltros);

      filtroBotones.forEach((btn) => {
        btn.addEventListener('click', () => {
          categoriaActiva = btn.dataset.filtroCat || '';
          filtroBotones.forEach((b) => {
            const activo = b === btn;
            b.setAttribute('aria-pressed', String(activo));
            b.classList.toggle('bg-ink', activo);
            b.classList.toggle('text-white', activo);
            b.classList.toggle('border-ink', activo);
            b.classList.toggle('bg-white', !activo);
            b.classList.toggle('text-text-soft', !activo);
            b.classList.toggle('border-line', !activo);
          });
          aplicarFiltros();
        });
      });
    }

    setupGlosario();
    document.addEventListener('astro:page-load', setupGlosario);
  </script>
</BaseLayout>
