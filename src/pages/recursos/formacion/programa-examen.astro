    formas: ['Dan-Gun (anterior)', 'Do-San (24 movimientos)'],
    combate: ['Técnicas de 1 y 3 pasos', 'Libre'],
    rotura: ['De pie: Yop Chagi', 'De mano: Niunja So Sonkal Kaunde Yop Taerigi'],
    teoria: ['Instructores que introdujeron el TK-D ITF en Chile', 'Clasificación de instructores y maestros', 'Significado y cantidad de movimientos de Do-San Tul', 'Significado del cinturón verde'],
  },
  {
    rango: '6° a 5° Gup',
    cinturon: 'Verde a Verde Punta Azul',
    posiciones: ['Las anteriores', 'Pies juntos (Moa Sogi)', 'En L larga (Gojung Sogi)', 'De una pierna (Goobooryo Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con canto de mano hacia adentro a zona alta (Sonkal Anuro Taerigi)'],
    ataquesPierna: ['Los anteriores', 'Patada lateral con giro 180° saltando (Twimyo Bandae Yop Chagi)', 'Patada descendente hacia adentro con salto (Twimyo Anuro Naeryo Chagi)', 'Patada circular hacia afuera con giro saltando (Twimyo Bandae Bakuro Sewo Chagi)', 'Patadas dobles-triples con misma pierna'],
    defensas: ['Las anteriores', 'En posición de guardia con antebrazo externo (Palmok Daebi Makgi)', 'Bajando y levantando con antebrazo interno (Palmok Dollimyo Makgi)'],
