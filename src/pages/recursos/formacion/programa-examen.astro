    combate: ['Técnicas de 1 y 3 pasos', 'Introducción a técnicas de 2 pasos', 'Libre'],
    rotura: ['De mano: Puño', 'De pie: Dollyo Chagi'],
    teoria: ['Fechas de nacimiento y muerte del Gral. Choi Hong Hi', 'Cultura Moral', 'Significado y cantidad de movimientos de Won-Hyo Tul', '¿Qué representa el color del cinturón azul?'],
  },
  {
    rango: '5° a 4° Gup',
    cinturon: 'Verde Punta Azul a Azul',
    posiciones: ['Las anteriores', 'Pies cruzados (Kyocha Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con codo frontal (Ap Palkup Taerigi)'],
    ataquesPierna: ['Los anteriores', 'Patada circular con gancho y giro 180° saltando (Twimyo Bandae Dollyo Goro Chagi)', 'Patada frontal y circular simultáneas saltando (Twimyo Apcha Dollyo Chagi)', 'Patadas en tensión simples', 'Patada descendente hacia adentro con giro 360°'],
    defensas: ['Las anteriores', 'De chequeo descendente con mano abierta (Golcho Makgi)', 'Con canto de mano a zona media y alta (Sang Sonkal Makgi)', 'Con antebrazo interno acompañado (Doo Palmok Makgi)'],
    formas: ['Won-Hyo (anterior)', 'Yul-Gok (38 movimientos)'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Libre'],
    rotura: ['De técnica: Twimyo Ap Chagi', 'De poder', 'Libre'],
    teoria: ['Explicación del saludo', 'El porqué de los 9 danes', 'Significado y cantidad de movimientos de Yul-Gok', 'Significado del cinturón azul'],
  },
  {
    rango: '4° a 3° Gup',
    cinturon: 'Azul a Azul Punta Roja',
    posiciones: ['Las anteriores', 'En L más corta (Dwitbal Sogi)', 'De caminar más larga (Nachuo Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con codo ascendente frontal (Wipalkup Taerigi)', 'Con puños dobles frontal (Sang Joomuk Sewo Jirugi)', 'Con puños tipo gancho a zona media (Sang Joomuk Dwijibo Jirugi)'],
    ataquesPierna: ['Los anteriores', 'Patada lateral saltando y girando 360°', 'Patada descendente hacia fuera con giro 180° saltando', 'Patada semicircular con salto y giro 360°', 'Patada abanico hacia adentro con salto y giro 360°', 'Introducción a Bituro Chagi'],
    defensas: ['Las anteriores', 'Con canto interno de mano (Sonkal Dung Bakuro Makgi)', 'Con palma de mano ascendente (Sombadak Ollyo Makgi)', 'Con puños en cruz a zona alta (Kyocha Joomuk Chukyo Makgi)', 'Con palma de mano descendente a zona baja (Sombadak Noollo Makgi)', 'Con arco de mano a zonas media y alta con ambas manos (Mongdung-I Makgi)'],
    formas: ['Yul-Gok (anterior)', 'Joong-Gun (32 movimientos)'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Semi libre', 'Libre'],
    defensaPersonal: ['Resolución de agarres (brazos, cuello, pelo, ropa, desde adelante, desde atrás)'],
    rotura: ['De técnica: Twimyo Nomo Yop Chagi', 'De poder: Solo de pies', 'Libre'],
    teoria: ['Deberes del alumno', 'Historia del Taekwon-Do', '¿Qué representa el color del cinturón rojo?', 'Significado y cantidad de movimientos de Joong-Gun'],
  },
  {
    rango: '3° a 2° Gup',
    cinturon: 'Azul Punta Roja a Rojo',
    posiciones: ['Las anteriores'],
    ataquesBrazo: ['Los anteriores', 'Con punta de dedos a zona baja a pie invertido (Dwijibun Sonkut Tulgi)', 'Con revés del puño a zona alta y hacia atrás (Dung Joomuk Yop Dwi Taerigi)', 'Con punta de dedos a zona alta (Opun Sonkut Tulgi)'],
    ataquesPierna: ['Los anteriores', 'Con rodilla ascendente (Moorup Ollyo Chagi)', 'Patada circular hacia afuera con salto y giro 360°', 'Patada lateral con gancho con salto y giro 360°', 'Patada fronto-lateral (Yobap Chagi)', 'Patada de torsión (Bituro Chagi)', 'Patadas retrocediendo'],
    defensas: ['Las anteriores', 'Con puños en cruz a zona baja (Kyocha Joomuk Noollo Makgi)', 'Con antebrazos externos dobles a zona alta (Bakat Palmok Hechyo Makgi)', 'Con antebrazo interno acompañado empujando a zona baja (Doopalmok Najunde Miro Makgi)', 'Con canto de mano a zona baja (Sonkal Najunde Daebi Makgi)'],
    formas: ['Joong-Gun (anterior)', 'Toi-Gye (37 movimientos)'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Semi libre', 'Libre'],
    defensaPersonal: ['Resolución con desequilibrio del oponente (barrido, trabado, empujón, lanzamiento)'],
    rotura: ['De técnica: Giros 360°, dos focos', 'De poder', 'Libre'],
    teoria: ['Historia del Taekwon-Do ITF en Chile', 'Tipos de mociones', 'Significado y cantidad de movimientos de Toi-Gye Tul', 'Significado del cinturón rojo'],
  },
  {
    rango: '2° a 1° Gup',
    cinturon: 'Rojo a Rojo Punta Negra',
    posiciones: ['Las anteriores', 'En L vertical (Soo Jik Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con puño frontal ascendente (Ollyo Jirugi)', 'Con canto de mano descendente (Sonkal Naeryo Taerigi)', 'Con codo hacia atrás (Yop Palkup Tulgi)'],
    ataquesPierna: ['Los anteriores', 'Patada descendente hacia fuera saltando y giro 360°', 'Patada trasera con talón (Dwitcha Busigi)', 'Doble patada frontal saltando (Twimyo Sangbal Ap Chagi)', 'Patadas de precisión frente a compañero'],
    defensas: ['Las anteriores', 'Con palma de mano empujando (Sonbadak Miro Makgi)', 'Con antebrazo interno de frente y hacia el costado (An Palmok Yobap Makgi)'],
    formas: ['Toi-Gye (anterior)', 'Hwa-Rang (29 movimientos)'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Libre'],
    defensaPersonal: ['Resolución de ataques y tomas de palancas (cuello, hombro, codo, muñecas, dedos, rodillas)'],
    rotura: ['De técnica: Twimyo Bandae Dollyo Chagi', 'De poder: Dollyo Chagi mínimo 2 pulgadas', 'Libre'],
    teoria: ['¿Qué es el Tul?', 'Distintos tipos de enfrentamiento', 'Diferencia entre Arte Marcial y Deporte', 'Ciclo de composición del Taekwon-Do', 'Significado y cantidad de movimientos de Hwa-Rang Tul', '¿Qué representa el color del cinturón negro?'],
  },
  {
    rango: '1° Gup a 1er Dan',
    cinturon: 'Rojo Punta Negra a Negro',
    posiciones: ['Revisión de todas las anteriores'],
    ataquesBrazo: ['Los anteriores', 'Con revés de canto de mano (Sonkal Dung Ap Taerigi)'],
    ataquesPierna: ['Los anteriores', 'Patada abanico hacia fuera saltando (Twimyo Bakuro Sewo Chagi)', 'Patada abanico hacia dentro saltando (Twimyo Anuro Sewo Chagi)', 'Patada con talón hacia atrás (Dwitcha Busigi)', 'Dos golpes con un salto'],
    defensas: ['Las anteriores', 'Con antebrazo externo hacia adentro (Palmok Kaunde Ap Makgi)', 'Con cantos de manos en cruz (Kyocha Sonkal Monchau Makgi)', 'Con palmas de manos ascendentes (Sang Sonbadak Ollyo Makgi)'],
    formas: ['Hwa-Rang (anterior)', 'Choong-Moo (30 movimientos)', 'Revisión de cualquier forma anterior'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Semi libre', 'Libre'],
    defensaPersonal: ['Resolución con toma de pierna sobre cualquier patada', 'Estudio y aplicación de puntos vitales en agarres y/o ataques'],
    rotura: ['De técnica', 'De poder', 'Libre'],
    teoria: ['Teoría del poder', 'Relación instructor-alumno', '1er Dan: ¿Experto o novato?', 'Cultura Moral y Filosofía del Taekwon-Do', 'Significado y cantidad de movimientos de Choong-Moo', '¿Qué representa el color del cinturón negro?', 'Vocabulario'],
  },
];

const descripcionPrograma =
  'Diseñada y revisada por los Sabumnim Osvaldo Rojas y Javier Lillo, Directores Técnicos de FECHITAT. Cada grado incluye los requisitos de posiciones, técnicas, formas, combate, rotura y teoría.';
const programaSanity = await getProgramaExamen();
const programaVisible = programaSanity?.grados?.length
  ? programaSanity
  : { titulo: 'Programa de examinación FECHITAT', descripcion: descripcionPrograma, grados };
---

<BaseLayout title={titulo} description={descripcion} mostrarFooter={false}>
  <!-- Cabecera simple: solo el título de la página -->
  <div class="bg-white border-b border-line py-5 md:py-6">
    <div class="mx-auto w-full max-w-screen-2xl px-5 md:px-8 xl:px-12">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-heading text-ink tracking-tight m-0">Examen</h1>
    </div>
  </div>

  <!-- Card simplificada de descarga de PDF -->
  <div class="mx-auto w-full max-w-screen-2xl px-5 md:px-8 xl:px-12 pt-6">
    <div class="bg-white border border-line rounded-xl p-5 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-lg sm:text-xl font-bold font-heading text-ink mb-0.5">Programa de examinación</h2>
        <p class="text-sm text-text-soft m-0">23 páginas - PDF</p>
      </div>
      <div>
        <a
          href="/documentos/programa-examen-fechitat.pdf"
          download="Programa-examen-FECHITAT.pdf"
          class="inline-flex min-h-11 items-center justify-center px-5 py-2.5 rounded-lg bg-red text-white text-sm font-bold uppercase tracking-wider hover:bg-red-dark transition-colors shadow-xs"
        >
          Descargar
        </a>
      </div>
    </div>
  </div>

  <section class="bg-white py-6 md:py-10">
    <div class="mx-auto w-full max-w-screen-2xl px-5 md:px-8 xl:px-12">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-xl sm:text-2xl font-bold font-heading text-ink m-0">Explora el programa</h2>
        <p id="grado-contador" class="font-mono text-sm text-text-soft m-0" aria-live="polite"></p>
      </div>

      <!-- Controles de grado y ajuste de texto minimalistas -->
      <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <!-- Selector desplegable de grado -->
        <div class="relative w-full sm:max-w-md">
          <label for="select-grado" class="sr-only">Seleccionar grado de examen</label>
          <select
            id="select-grado"
            class="w-full appearance-none bg-white border border-line rounded-xl pl-4 pr-10 py-2.5 text-sm font-bold text-ink shadow-2xs hover:border-ink/40 focus-visible:outline-2 focus-visible:outline-red cursor-pointer transition-colors"
          >
            {programaVisible.grados.map((grado, indice) => (
              <option value={indice}>
                {grado.rango} — {grado.cinturon}
              </option>
            ))}
          </select>
          <span class="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-text-soft">
            <UIcon name="chevron-down" size={16} />
          </span>
        </div>

        <!-- Ajuste de texto minimalista con botones A- y A+ -->
        <div class="flex items-center gap-1.5 self-end sm:self-auto" role="group" aria-label="Ajustar tamaño de texto">
          <span class="text-xs font-mono text-text-soft mr-1">Texto:</span>
          <button
            type="button"
            id="btn-font-dec"
            title="Reducir tamaño de letra"
            aria-label="Reducir tamaño de texto"
            class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-line bg-white hover:bg-paper text-ink font-mono text-xs font-bold transition-all active:scale-95 cursor-pointer shadow-2xs"
          >
            A-
          </button>
          <button
            type="button"
            id="btn-font-inc"
            title="Aumentar tamaño de letra"
            aria-label="Aumentar tamaño de texto"
            class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-line bg-white hover:bg-paper text-ink font-mono text-xs font-bold transition-all active:scale-95 cursor-pointer shadow-2xs"
          >
            A+
          </button>
        </div>
      </div>

      <!-- Barra de pills deslizables minimalistas con los rangos -->
      <nav
        aria-label="Seleccionar grado rápido"
        class="mb-6 -mx-5 px-5 md:mx-0 md:px-0 overflow-x-auto pb-2 scrollbar-none flex gap-1.5 snap-x"
        id="barra-cinturones"
      >
        {programaVisible.grados.map((grado, indice) => (
          <button
            type="button"
            data-grado-dot={indice}
            aria-pressed={indice === 0 ? 'true' : 'false'}
            class:list={[
              'shrink-0 snap-start px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer select-none',
              indice === 0
                ? 'bg-ink text-white border-ink'
                : 'bg-white text-text-soft border-line hover:border-ink hover:text-ink',
            ]}
          >
            {grado.rango}
          </button>
        ))}
      </nav>

      <div id="programa-lector" class="touch-pan-y">
        {programaVisible.grados.map((grado, indice) => (
          <article data-grado-panel={indice} hidden={indice !== 0} class="overflow-hidden bg-white">
            <header class="border-b border-line pb-4 mb-4">
              <span class="inline-block font-mono text-xs uppercase tracking-widest text-red font-bold">{grado.rango}</span>
              <h3 class="mt-1 text-2xl md:text-3xl font-extrabold font-heading text-ink">{grado.cinturon}</h3>
            </header>

            <!-- Cards compactas que permiten leer más información en menos espacio -->
            <div data-reader-text class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 pb-4" style="font-size: 16px; font-family: Kumbh Sans, sans-serif;">
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Posiciones (Sogi)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.posiciones.map((item) => <li>• {item}</li>)}</ul>
              </div>
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Ataques brazo (Son Gisool)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.ataquesBrazo.map((item) => <li>• {item}</li>)}</ul>
              </div>
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Ataques pierna (Bal Gisool)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.ataquesPierna.map((item) => <li>• {item}</li>)}</ul>
              </div>
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Defensa (Makgi)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.defensas.map((item) => <li>• {item}</li>)}</ul>
              </div>
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Formas (Tul)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.formas.map((item) => <li>• {item}</li>)}</ul>
              </div>
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Combate (Matsokgi)</h4>
                <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.combate.map((item) => <li>• {item}</li>)}</ul>
              </div>
              {grado.defensaPersonal && (
                <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                  <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Defensa personal</h4>
                  <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.defensaPersonal.map((item) => <li>• {item}</li>)}</ul>
                </div>
              )}
              {grado.rotura && (
                <div class="bg-paper/40 border border-line rounded-lg p-3.5 flex flex-col">
                  <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Rotura (Kyokpa)</h4>
                  <ul class="space-y-1 text-xs md:text-sm text-text-soft leading-snug">{grado.rotura.map((item) => <li>• {item}</li>)}</ul>
                </div>
              )}
              <div class="bg-paper/40 border border-line rounded-lg p-3.5 sm:col-span-2 lg:col-span-3 flex flex-col">
                <h4 class="mb-2 font-mono text-xs font-bold uppercase tracking-wider text-red">Teoría</h4>
                <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">{grado.teoria.map((item) => <li><button type="button" data-teoria={item} class="text-left text-xs text-text-soft underline decoration-dotted underline-offset-4 hover:text-red">{item} <span aria-hidden="true" class="text-red">↗</span></button></li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>

      <dialog id="teoria-dialog" class="rounded-sm border border-line bg-white p-0 shadow-2xl backdrop:bg-ink/70">
        <form method="dialog" class="p-6 md:p-8">
          <div class="flex items-start justify-between gap-5">
            <div><p class="font-mono text-xs uppercase tracking-widest text-red">Apuntes de teoría</p><h3 id="teoria-titulo" class="mt-2 text-2xl md:text-3xl"></h3></div>
            <button aria-label="Cerrar" class="text-2xl text-text-soft hover:text-red">×</button>
          </div>
          <p class="mt-4 text-lg leading-relaxed">La información de este tema se irá completando.</p>
          <div class="mt-5 flex justify-end"><button class="bg-ink px-5 py-3 font-mono text-xs uppercase tracking-wider text-white">Listo</button></div>
        </form>
      </dialog>

      <div class="mt-6 flex items-center justify-between gap-4">
        <button
          type="button"
          data-grado-prev
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-line bg-white hover:bg-paper font-mono text-xs font-bold uppercase tracking-wider text-ink transition-colors disabled:cursor-not-allowed disabled:opacity-40 cursor-pointer shadow-2xs"
        >
          ← Anterior
        </button>
        <button
          type="button"
          data-grado-next
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-line bg-white hover:bg-paper font-mono text-xs font-bold uppercase tracking-wider text-ink transition-colors disabled:cursor-not-allowed disabled:opacity-40 cursor-pointer shadow-2xs"
        >
          Siguiente →
        </button>
      </div>
    </div>
  </section>

  <script>
    const paneles = [...document.querySelectorAll<HTMLElement>('[data-grado-panel]')];
    const puntos = [...document.querySelectorAll<HTMLButtonElement>('[data-grado-dot]')];
    const selectGrado = document.querySelector<HTMLSelectElement>('#select-grado');
    const contador = document.querySelector<HTMLElement>('#grado-contador');
    const anterior = document.querySelector<HTMLButtonElement>('[data-grado-prev]');
    const siguiente = document.querySelector<HTMLButtonElement>('[data-grado-next]');
    const lector = document.querySelector<HTMLElement>('#programa-lector');
    const btnFontDec = document.querySelector<HTMLButtonElement>('#btn-font-dec');
    const btnFontInc = document.querySelector<HTMLButtonElement>('#btn-font-inc');
    const dialogoTeoria = document.querySelector<HTMLDialogElement>('#teoria-dialog');
    const tituloTeoria = document.querySelector<HTMLElement>('#teoria-titulo');
    let gradoActivo = 0;
    let inicioDeslizamiento = 0;

    // Escala de tamaños de fuente minimalista
    const tamanosFuente = [13, 14, 16, 18, 20];
    let indiceTamano = 2; // 16px por defecto

    function aplicarTamanoTexto() {
      const px = tamanosFuente[indiceTamano];
      document.querySelectorAll<HTMLElement>('[data-reader-text]').forEach((contenido) => {
        contenido.style.fontSize = `${px}px`;
      });
      if (btnFontDec) btnFontDec.disabled = indiceTamano === 0;
      if (btnFontInc) btnFontInc.disabled = indiceTamano === tamanosFuente.length - 1;
    }

    btnFontDec?.addEventListener('click', () => {
      if (indiceTamano > 0) {
        indiceTamano--;
        aplicarTamanoTexto();
      }
    });

    btnFontInc?.addEventListener('click', () => {
      if (indiceTamano < tamanosFuente.length - 1) {
        indiceTamano++;
        aplicarTamanoTexto();
      }
    });

    /** Muestra un grado del programa y actualiza los controles de navegación.
     * @param indice Índice del grado que se mostrará.
     */
    function mostrarGrado(indice: number) {
      if (indice < 0 || indice >= paneles.length) return;
      gradoActivo = indice;
      paneles.forEach((panel, posicion) => { panel.hidden = posicion !== gradoActivo; });
      if (selectGrado && selectGrado.value !== String(gradoActivo)) {
        selectGrado.value = String(gradoActivo);
      }
      puntos.forEach((punto, posicion) => {
        const activo = posicion === gradoActivo;
        punto.setAttribute('aria-pressed', String(activo));
        punto.classList.toggle('bg-ink', activo);
        punto.classList.toggle('text-white', activo);
        punto.classList.toggle('border-ink', activo);
        punto.classList.toggle('bg-white', !activo);
        punto.classList.toggle('text-text-soft', !activo);
        punto.classList.toggle('border-line', !activo);
        if (activo) {
          punto.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
      if (contador) contador.textContent = `Grado ${gradoActivo + 1} de ${paneles.length}`;
      if (anterior) anterior.disabled = gradoActivo === 0;
      if (siguiente) siguiente.disabled = gradoActivo === paneles.length - 1;
    }

    selectGrado?.addEventListener('change', () => {
      mostrarGrado(Number(selectGrado.value));
    });

    puntos.forEach((punto) => punto.addEventListener('click', () => mostrarGrado(Number(punto.dataset.gradoDot))));
    anterior?.addEventListener('click', () => mostrarGrado(gradoActivo - 1));
    siguiente?.addEventListener('click', () => mostrarGrado(gradoActivo + 1));
    lector?.addEventListener('pointerdown', (evento) => { if (evento.pointerType === 'touch') inicioDeslizamiento = evento.clientX; });
    lector?.addEventListener('pointerup', (evento) => {
      if (evento.pointerType !== 'touch') return;
      const desplazamiento = evento.clientX - inicioDeslizamiento;
      if (Math.abs(desplazamiento) > 55) mostrarGrado(gradoActivo + (desplazamiento < 0 ? 1 : -1));
    });

    document.querySelectorAll<HTMLButtonElement>('[data-teoria]').forEach((boton) => {
      boton.addEventListener('click', () => {
        if (tituloTeoria) tituloTeoria.textContent = boton.dataset.teoria ?? '';
        dialogoTeoria?.showModal();
      });
    });

    aplicarTamanoTexto();
    mostrarGrado(0);
  </script>
  <style>
    #teoria-dialog {
      position: fixed;
      inset: 0;
      width: min(42rem, calc(100% - 2rem));
      max-height: 85vh;
      margin: auto;
      overflow-y: auto;
    }

    #programa-lector [data-reader-text] li,
    #programa-lector [data-reader-text] button {
      font-size: inherit;
      line-height: 1.65;
    }
  </style>
</BaseLayout>
