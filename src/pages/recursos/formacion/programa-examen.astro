  {
    rango: '9° a 8° Gup',
    cinturon: 'Blanco Punta Amarilla a Amarillo',
    posiciones: ['Las anteriores', 'En L (Niunja Sogi)'],
    ataquesBrazo: ['Los anteriores'],
    ataquesPierna: ['Las anteriores', 'Ap Cha Ollygi', 'Patada lateral con talón (Yop Chagi)', 'Combinaciones de dos técnicas'],
    defensas: ['Las anteriores'],
    formas: ['Cruz de ataque (anterior)', 'Cruz de defensa (anterior)', 'Chon-Ji (19 movimientos)'],
    combate: ['Técnicas de un paso (Ilbo Matsokgi)', 'Técnicas de tres pasos con oponente (Sambo Matsokgi)', 'Semi libre'],
    teoria: ['Juramento del Taekwon-Do', '¿Qué representa el color del cinturón amarillo?', 'Significado y cantidad de movimientos de Chon-Ji Tul'],
  },
  {
    rango: '8° a 7° Gup',
    cinturon: 'Amarillo a Amarillo Punta Verde',
    posiciones: ['Las anteriores'],
    ataquesBrazo: ['Los anteriores', 'Con puño frontal a zona alta (Nopunde Jirugi)', 'Con canto de mano (Sonkal Dollyo Taerigi)'],
    ataquesPierna: ['Los anteriores', 'Patada lateral con talón (Yop Chagi)', 'Patada descendente hacia fuera (Bakuro Naeryo Chagi)', 'Patada descendente hacia adentro (Anuro Naeryo Chagi)', 'Patada circular hacia afuera con giro (Bandae Bakuro Sewo Chagi)', 'Patada trasera (Bandae Yop Chagi)', 'Patada semicircular con salto (Twimyo Dollyo Chagi)', 'Combinaciones'],
    defensas: ['Las anteriores', 'Con canto de mano a zona media (Sonkal Daebi Makgi)', 'Con antebrazos externos a zonas media y alta (Sang Palmok Makgi)', 'Con antebrazo externo a zona alta (Palmok Chukyo Makgi)'],
    formas: ['Chon-Ji (anterior)', 'Dan-Gun (21 movimientos)'],
    combate: ['Técnicas de un paso', 'Técnicas de tres pasos', 'Libre'],
    teoria: ['¿Qué representa el color del cinturón verde?', 'Fecha de creación del Taekwon-Do y de la ITF', 'Significado y cantidad de movimientos de Dan-Gun Tul'],
  },
  {
    rango: '7° a 6° Gup',
    cinturon: 'Amarillo Punta Verde a Verde',
    posiciones: ['Las anteriores', 'De jinete (Annun Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con punta de dedos (Sun Sonkut Tulgi)', 'Con revés del puño (Dung Joomuk)'],
    ataquesPierna: ['Los anteriores', 'Patada lateral con gancho (Goro Chagi)', 'Patada lateral con gancho girando (Bandae Dollyo Goro Chagi)', 'Patada lateral con talón saltando (Twimyo Yop Chagi)', 'Combinaciones de pies y de pies y manos'],
