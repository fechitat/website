---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import DocumentoVisor from '../../../components/DocumentoVisor.astro';
import { getProgramaExamen } from '../../../lib/sanityQueries';

export const prerender = true;
export const revalidate = 3600;

const titulo = 'Programa de examen — FECHITAT';
const descripcion =
  'Revisa los requisitos por grado para el examen de Taekwon-Do ITF: posiciones, técnicas, Tuls, combate, roturas y teoría.';

interface Grado {
  rango: string;
  cinturon: string;
  posiciones: string[];
  ataquesBrazo: string[];
  ataquesPierna: string[];
  defensas: string[];
  formas: string[];
  combate: string[];
  rotura?: string[];
  teoria: string[];
  defensaPersonal?: string[];
}

const grados: Grado[] = [
  {
    rango: '10° a 9° Gup',
    cinturon: 'Blanco a Blanco Punta Amarilla',
    posiciones: ['De atención (Charyot Sogi)', 'De saludo (Kyong Ye Jase)', 'De pies paralelos (Narani Sogui)', 'De caminar (Gunnun Sogi)'],
    ataquesBrazo: ['Con puño frontal (Ap Joomuk)'],
    ataquesPierna: ['Patada frontal (Ap Chagi)', 'Patada circular hacia fuera (Bakuro Bandal Chagi)', 'Patada circular hacia dentro (Anuro Bandal Chagi)', 'Patada semicircular (Dollyo Chagi)', 'Patada frontal saltando (Twimyo Ap Chagi)'],
    defensas: ['Zona baja con antebrazo externo (Palmok Najunde Makgi)', 'Zona baja con canto de mano (Sonkal Najunde Makgi)', 'Zona media con antebrazo interno (An Palmok Kaunde Makgi)'],
    formas: ['Cruz de ataque (Saju Jirugi)', 'Cruz de defensa (Saju Makgi)'],
    combate: ['Introducción a técnicas de tres pasos (Sambo Matsokgi)', 'Semi libre (una técnica cada uno)'],
