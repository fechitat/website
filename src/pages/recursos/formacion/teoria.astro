---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import DocumentoVisor from '../../../components/DocumentoVisor.astro';

export const prerender = true;

const titulo = 'Teoría de examen — FECHITAT';
const descripcion = 'Consulta y descarga el manual de teoría para los exámenes de Taekwon-Do ITF de FECHITAT.';
const temas = [
  'Definición, fundador e historia del Taekwon-Do',
  'Principios, juramento y significado del dobok',
  'Combate a uno, dos y tres pasos',
  'Puntos vitales y vocabulario',
  'Teoría del poder y significado de los cinturones',
];
---

<BaseLayout title={titulo} description={descripcion}>
  <PageHero
    title="Teoría de examen"
    crumb="Recursos"
    crumbHref="/recursos"
    description="Manual oficial de teoría FECHITAT. Puedes verlo en el navegador o descargarlo para estudiar."
  />
  <DocumentoVisor
    titulo="Manual de examen FECHITAT"
    archivo="/documentos/teoria-examen-fechitat.pdf"
    nombreDescarga="Teoria-examen-FECHITAT.pdf"
    paginas={34}
    peso="1,4 MB"
  />
  <section class="bg-paper py-8 md:py-12 transition-colors duration-200" id="teoria-seccion">
    <div class="mx-auto w-full max-w-3xl px-5 md:px-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="mb-0">Qué incluye</h2>
        <button
          type="button"
          id="btn-modo-oscuro"
          class="px-3.5 py-1.5 rounded-full border border-line bg-white text-xs font-mono font-bold text-text-soft hover:text-ink hover:border-ink transition-colors cursor-pointer"
        >
          🌙 Modo Dojang (Oscuro)
        </button>
      </div>
      <ul class="mt-4 space-y-2">
        {temas.map((tema) => <li class="text-text-soft">• {tema}</li>)}
      </ul>

      <!-- Enlaces útiles -->
      <div class="mt-8 pt-6 border-t border-line flex flex-wrap gap-4 text-xs font-bold">
        <a href="/recursos/formacion/diagramas-tuls" class="text-red hover:underline">
          📐 Ver Diagramas y Significados de Tuls →
        </a>
        <a href="/recursos/formacion/evaluacion-examen" class="text-red hover:underline">
          📋 Abrir Ficha de Evaluación de Examen →
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    function setupTeoriaModo() {
      const btnModo = document.getElementById('btn-modo-oscuro');
      const seccion = document.getElementById('teoria-seccion');
      if (!btnModo || !seccion) return;

      btnModo.addEventListener('click', () => {
        const esOscuro = seccion.classList.toggle('modo-oscuro');
        btnModo.textContent = esOscuro ? '☀️ Modo Claro' : '🌙 Modo Dojang (Oscuro)';
      });
    }

    setupTeoriaModo();
    document.addEventListener('astro:page-load', setupTeoriaModo);
  </script>

  <style>
    #teoria-seccion.modo-oscuro {
      background-color: #0b1220 !important;
      color: #ffffff !important;
    }
    #teoria-seccion.modo-oscuro h2,
    #teoria-seccion.modo-oscuro li,
    #teoria-seccion.modo-oscuro a {
      color: #f1f5f9 !important;
    }
    #teoria-seccion.modo-oscuro #btn-modo-oscuro {
      background-color: #1e293b;
      color: #ffffff;
      border-color: #475569;
    }
  </style>
</BaseLayout>
