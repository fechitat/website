---
import EventBadge from "../components/EventBadge.astro";
import PageHero from "../components/PageHero.astro";
import Tag from "../components/Tag.astro";
import UIcon from "../components/icons/UIcon.astro";
import Button from "../components/ui/Button.astro";
import BotonCalendario from "../components/ui/BotonCalendario.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { urlFor } from "../lib/sanity";
import {
  getEventosPasados,
  getProximoEventoDestacado,
  getProximosEventos,
} from "../lib/sanityQueries";

export const prerender = true;
export const revalidate = 3600; // ISR: los eventos se refrescan como máximo 1×/hora

const titulo = "Eventos — FECHITAT";
const descripcion =
  "Consulta el calendario de campeonatos, seminarios y exámenes de Taekwon-Do ITF organizados por FECHITAT en Chile.";

// Datos de Sanity
const [eventoPrincipal, proximosRaw, pasados] = await Promise.all([
  getProximoEventoDestacado(),
  getProximosEventos(),
  getEventosPasados(12),
]);
// Excluir el evento destacado de la lista de próximos
const proximos = eventoPrincipal
  ? proximosRaw.filter((e) => e._id !== eventoPrincipal._id)
  : proximosRaw;
// Los eventos pasados restantes se cargan bajo demanda desde el endpoint.

const labelTipo = (tipo: string) => {
  if (tipo === "competencia") return "Competencia";
  if (tipo === "examen") return "Examen";
  if (tipo === "seminario") return "Seminario";
  if (tipo === "exhibicion") return "Exhibición";
  return "Otro";
};

/**
 * Determina si un evento tiene contenido suficiente para abrir su detalle.
 *
 * @param evento - Evento recibido desde Sanity.
 * @returns true cuando tiene descripción o una galería con fotos.
 */
const puedeAbrirEvento = (evento) => Boolean(evento.slug?.current);

const fechaLarga = (fecha: string) =>
  new Date(fecha).toLocaleDateString("es-CL", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const jsonLdEventoPrincipal = eventoPrincipal
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Event",
      name: eventoPrincipal.titulo,
      startDate: eventoPrincipal.fecha,
      endDate: eventoPrincipal.fechaFin ?? undefined,
      ...(eventoPrincipal.direccion || eventoPrincipal.ciudad
        ? {
            location: {
              "@type": "Place",
              name: eventoPrincipal.direccion ?? eventoPrincipal.ciudad,
              address: {
                "@type": "PostalAddress",
                addressLocality: eventoPrincipal.ciudad ?? "",
                addressCountry: "CL",
              },
            },
          }
        : {}),
      description: eventoPrincipal.descripcion ?? eventoPrincipal.titulo,
      eventStatus: "https://schema.org/EventScheduled",
      organizer: {
        "@type": "SportsOrganization",
        name: "FECHITAT",
        url: "https://fechitat-website.vercel.app",
      },
    })
  : null;
---

<BaseLayout title={titulo} description={descripcion} structuredData={jsonLdEventoPrincipal ? JSON.parse(jsonLdEventoPrincipal) : undefined}>
  <PageHero
    title="Eventos y competencias"
    description="Campeonatos, seminarios técnicos y exámenes de grado de FECHITAT."
  />

  <!-- Calendario: próximo evento destacado + próximos eventos -->
  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      {
        eventoPrincipal && (
          <article class="bg-white border border-line rounded-sm overflow-hidden text-ink">
            <div class="grid grid-cols-1 lg:grid-cols-5">
              {eventoPrincipal.flyer && (
                <div class="bg-paper lg:col-span-2">
                  {puedeAbrirEvento(eventoPrincipal) ? (
                    <a href={`/eventos/${eventoPrincipal.slug.current}`} class="block w-full aspect-square overflow-hidden" aria-label={`Ver ${eventoPrincipal.titulo}`}>
                      <img src={urlFor(eventoPrincipal.flyer).width(640).height(640).fit('crop').auto('format').quality(75).url()}
                        alt={`Afiche de ${eventoPrincipal.titulo}`} width="640" height="640"
                        class="w-full h-full object-cover" fetchpriority="high" decoding="async" />
                    </a>
                  ) : (
                    <img src={urlFor(eventoPrincipal.flyer).width(640).height(640).fit('crop').auto('format').quality(75).url()}
                      alt={`Afiche de ${eventoPrincipal.titulo}`} width="640" height="640"
                      class="w-full aspect-square object-cover" decoding="async" />
                  )}
                </div>
              )}
              <div class:list={['p-6 md:p-10 flex flex-col', eventoPrincipal.flyer ? 'lg:col-span-3' : 'lg:col-span-5']}>
                <span class="font-mono text-xs tracking-wider uppercase text-red">
                  Próximo evento
                </span>
                <h2 class="text-ink text-[clamp(1.5rem,4vw,2.8rem)] mb-4 m-0">
                  {eventoPrincipal.titulo}
                </h2>
                <div class="flex flex-wrap gap-4 font-mono text-xs tracking-wider text-text-soft mb-6">
                  {eventoPrincipal.lugar && (
                    <span class="flex items-center gap-1">
                      <UIcon name="map-pin" size={14} /> {eventoPrincipal.lugar}
                    </span>
                  )}
                  <span>
                    <time datetime={eventoPrincipal.fecha}>{fechaLarga(eventoPrincipal.fecha)}</time>
                    {eventoPrincipal.fechaFin && (
                      <> – <time datetime={eventoPrincipal.fechaFin}>{fechaLarga(eventoPrincipal.fechaFin)}</time></>
                    )}
                  </span>
                </div>
                {eventoPrincipal.descripcion && (
                  <p class="text-text-soft mt-4 mb-6 max-w-[48ch] text-sm md:text-base">
                    {eventoPrincipal.descripcion}
                  </p>
                )}
                <div class="mt-auto flex flex-wrap gap-3">
                  <Button
                    href={
                      puedeAbrirEvento(eventoPrincipal)
                        ? `/eventos/${eventoPrincipal.slug.current}`
                        : undefined
                    }
                    disabled={!puedeAbrirEvento(eventoPrincipal)}
                    variant="primary"
                    size="sm"
                  >
                    Ver detalle del evento
                  </Button>
                  <BotonCalendario
                    evento={eventoPrincipal}
                    className="border border-ink text-ink"
                  />
                </div>
              </div>
            </div>
          </article>
        )
      }

      {
        proximos.length > 0 ? (
          <>
            <div class="mt-10 mb-8">
              <h2>{eventoPrincipal ? "Más eventos próximos" : "Próximos eventos"}</h2>
            </div>
            <ul class="flex flex-col mt-8 list-none p-0 m-0">
              {proximos.map((evento) => (
                <li>
                  <div class="flex items-start gap-4 md:gap-6 py-5 md:py-6 border-b border-line">
                    <div class="flex-none relative z-[1]">
                      <EventBadge
                        mes={new Date(evento.fecha)
                          .toLocaleDateString("es-CL", { month: "short" })
                          .toUpperCase()}
                        dia={new Date(evento.fecha).getDate().toString()}
                        large
                      />
                    </div>
                    <div class="flex-1 min-w-0">
                      <span class="font-mono text-xs tracking-wider uppercase text-text-soft">
                        {labelTipo(evento.tipo)}
                      </span>
                      {puedeAbrirEvento(evento) ? (
                        <a
                          href={`/eventos/${evento.slug.current}`}
                          class="text-ink hover:text-red"
                        >
                          <h3 class="text-base md:text-lg mb-1 inline">{evento.titulo}</h3>
                        </a>
                      ) : (
                        <h3 class="text-base md:text-lg mb-1">{evento.titulo}</h3>
                      )}
                      <div class="flex flex-wrap gap-3 font-mono text-xs tracking-wider text-text-soft">
                        {evento.lugar && (
                          <span class="flex items-center gap-1">
                            <UIcon name="map-pin" size={12} /> {evento.lugar}
                          </span>
                        )}
                        <span>
                          <time datetime={evento.fecha}>{fechaLarga(evento.fecha)}</time>
                          {evento.fechaFin && (
                            <> – <time datetime={evento.fechaFin}>{fechaLarga(evento.fechaFin)}</time></>
                          )}
                        </span>
                      </div>
                      {evento.descripcion && (
                        <p class="text-text-soft text-sm mt-2">{evento.descripcion}</p>
                      )}
                      <div class="mt-3">
                        <BotonCalendario
                          evento={evento}
                          className="border border-line text-ink px-4 py-2"
                        />
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </>
        ) : !eventoPrincipal ? (
          <div>
            <div class="mb-6">
              <h2>Próximos eventos</h2>
            </div>
            <p class="text-text-soft text-sm mt-1 max-w-md">
              Estamos preparando el calendario de las próximas actividades. Revisa los eventos pasados a continuación o síguenos en nuestras redes.
            </p>
          </div>
        ) : null
      }
    </div>
  </section>

  <!-- Eventos pasados (con "Ver más" client-side) -->
  {
    pasados.length > 0 && (
      <section class="py-10 md:py-16">
        <div class="max-w-7xl mx-auto px-5 md:px-7">
          <div class="mb-8">
            <h2>Eventos pasados</h2>
          </div>
          <div id="eventos-pasados" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {pasados.map((evento) => (
              <article class="bg-white border border-line rounded-sm overflow-hidden flex flex-col">
                {evento.flyer && (
                  <div class="bg-paper w-full aspect-square overflow-hidden">
                    {puedeAbrirEvento(evento) ? (
                      <a href={`/eventos/${evento.slug.current}`} class="block w-full h-full" aria-label={`Ver ${evento.titulo}`}>
                        <img src={urlFor(evento.flyer).width(480).height(480).fit('crop').auto('format').quality(75).url()}
                          alt={`Afiche de ${evento.titulo}`} width="480" height="480" loading="lazy" decoding="async"
                          class="w-full h-full object-cover" />
                      </a>
                    ) : (
                      <img src={urlFor(evento.flyer).width(480).height(480).fit('crop').auto('format').quality(75).url()}
                        alt={`Afiche de ${evento.titulo}`} width="480" height="480" loading="lazy" decoding="async"
                        class="w-full h-full object-cover" />
                    )}
                  </div>
                )}
                <div class="p-4 md:p-5 flex-1 flex flex-col">
                  {puedeAbrirEvento(evento) ? (
                    <a href={`/eventos/${evento.slug.current}`} class="text-ink hover:text-red">
                      <h3 class="text-sm md:text-base mb-1">{evento.titulo}</h3>
                    </a>
                  ) : (
                    <h3 class="text-sm md:text-base mb-1">{evento.titulo}</h3>
                  )}
                  <div class="flex items-center gap-2 text-text-soft text-sm mt-auto">
                    <span>
                      <time datetime={evento.fecha}>
                        {new Date(evento.fecha).toLocaleDateString("es-CL", {
                          day: "numeric",
                          month: "short",
                        })}
                      </time>
                      {evento.fechaFin && (
                        <>
                          <span>–</span>
                          <time datetime={evento.fechaFin}>
                            {new Date(evento.fechaFin).toLocaleDateString("es-CL", {
                              day: "numeric",
                              month: "short",
                            })}
                          </time>
                        </>
                      )}
                    </span>
                    {evento.lugar && (
                      <>
                        <span>·</span>
                        <span class="flex items-center gap-1">
                          <UIcon name="map-pin" size={12} />
                          {evento.lugar}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="text-center mt-8">
            <button
              id="ver-mas-eventos"
              type="button"
              class="inline-flex items-center gap-2 bg-ink text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-black hover:-translate-y-px cursor-pointer"
            >
              Ver más eventos
            </button>
          </div>
          <p id="estado-eventos" class="sr-only" role="status" aria-live="polite"></p>
        </div>
      </section>
    )
  }

  <script>
    // "Ver más" eventos pasados: carga el siguiente bloque desde el endpoint JSON
    const boton = document.getElementById('ver-mas-eventos');
    const contenedor = document.getElementById('eventos-pasados');
    const estado = document.getElementById('estado-eventos');

    if (boton && contenedor) {
      let offset = 12;

      boton.addEventListener('click', async () => {
        boton.disabled = true;
        boton.textContent = 'Cargando…';
        try {
          const respuesta = await fetch(`/api/eventos-pasados?offset=${offset}`);
          if (!respuesta.ok) throw new Error('Error de red');
          const datos = await respuesta.json();

          const fragmento = document.createElement('div');
          fragmento.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 col-span-full';
          for (const e of datos.eventos) {
            const href = e.slug?.current ? `/eventos/${encodeURIComponent(e.slug.current)}` : null;
            const article = document.createElement('article');
            article.className = 'bg-white border border-line rounded-sm overflow-hidden flex flex-col';
            if (e.flyerUrl) {
              const imagen = document.createElement('img');
              const flyerUrl = new URL(e.flyerUrl);
              flyerUrl.searchParams.set('w', '480');
              flyerUrl.searchParams.set('h', '480');
              flyerUrl.searchParams.set('fit', 'crop');
              flyerUrl.searchParams.set('auto', 'format');
              flyerUrl.searchParams.set('q', '75');
              imagen.src = flyerUrl.toString();
              imagen.alt = `Afiche de ${e.titulo}`;
              imagen.loading = 'lazy';
              imagen.decoding = 'async';
              imagen.width = 480;
              imagen.height = 480;
              imagen.className = 'w-full h-full object-cover';
              const marco = document.createElement(href ? 'a' : 'div');
              marco.className = 'block bg-paper w-full aspect-square overflow-hidden';
              if (href && marco instanceof HTMLAnchorElement) marco.href = href;
              marco.appendChild(imagen);
              article.appendChild(marco);
            }
            const contenido = document.createElement('div');
            contenido.className = 'p-4 md:p-5 flex-1 flex flex-col';
            const titulo = document.createElement('h3');
            titulo.className = 'text-sm md:text-base mb-1';
            titulo.textContent = e.titulo;
            if (href) {
              const link = document.createElement('a');
              link.href = href;
              link.className = 'text-ink hover:text-red';
              link.appendChild(titulo);
              contenido.appendChild(link);
            } else contenido.appendChild(titulo);
            const fecha = document.createElement('p');
            fecha.className = 'text-text-soft text-sm mt-auto';
            fecha.textContent = new Date(e.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'short' });
            contenido.appendChild(fecha);
            article.appendChild(contenido);
            fragmento.appendChild(article);
          }

          contenedor.appendChild(fragmento);
          offset += datos.eventos.length;
          estado.textContent = `Se mostraron ${Math.min(offset, datos.total)} de ${datos.total} eventos.`;

          if (offset >= datos.total) {
            boton.remove();
          } else {
            boton.disabled = false;
            boton.textContent = 'Ver más eventos';
          }
        } catch {
          estado.textContent = 'No se pudieron cargar más eventos.';
          boton.disabled = false;
          boton.textContent = 'Ver más eventos';
        }
      });
    }
  </script>
</BaseLayout>