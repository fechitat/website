---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../lib/imagenes';
import { getTestimonios } from '../lib/sanityQueries';

export const prerender = true;
export const revalidate = 3600;

const titulo = 'Para padres — FECHITAT';
const descripcion =
  'Conoce los beneficios, edades, seguridad y pasos para inscribir a tu hijo o hija en Taekwon-Do ITF con FECHITAT.';

const beneficios = [
  { etiqueta: 'Disciplina', variante: 'red', texto: 'Rutinas claras y metas por cinturón que enseñan constancia dentro y fuera de clase.' },
  { etiqueta: 'Confianza', variante: 'blue', texto: 'Cada examen superado refuerza la seguridad en sí mismos, en el tatami y en la vida diaria.' },
  { etiqueta: 'Respeto', variante: 'gold', texto: 'El saludo, la jerarquía de grados y el trabajo en pareja enseñan a respetar a otros y a sí mismos.' },
  { etiqueta: 'Condición física', variante: 'default', texto: 'Coordinación, flexibilidad y resistencia, con progresiones adecuadas a cada edad.' },
];

// Datos de Sanity
const testimonios = await getTestimonios();

const faqs = [
  { pregunta: '¿A qué edad puede empezar mi hijo/a?', respuesta: 'Recibimos alumnos desde los 5 años en clases infantiles, con progresiones adaptadas a cada etapa de desarrollo.' },
  { pregunta: '¿Necesita experiencia previa?', respuesta: 'No. La mayoría de los alumnos comienza sin experiencia; el uniforme y el cinturón blanco se entregan al inscribirse.' },
  { pregunta: '¿Cuántas veces por semana se entrena?', respuesta: 'Las escuelas afiliadas ofrecen entre 2 y 3 clases semanales; cada escuela define su propio horario.' },
  { pregunta: '¿Pueden competir a nivel nacional?', respuesta: 'Sí, una vez alcanzado el nivel adecuado pueden participar en el calendario nacional y, con buen desempeño, en la selección para torneos internacionales.' },
];
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.pregunta,
    acceptedAnswer: { "@type": "Answer", text: faq.respuesta },
  })),
};
---

<BaseLayout title={titulo} description={descripcion} structuredData={faqJsonLd}>
  <PageHero
    title="Un deporte que forma<br />el carácter de tu hijo/a"
    crumb="Para padres"
    description="Más que patadas y cinturones: disciplina, respeto, autocontrol y confianza, guiados por instructores certificados en un ambiente seguro y supervisado."
    image={img.ninosClase}
    imageAlt="Niños practicando Taekwon-Do ITF"
    imageStyle="border-radius:2px;"
  >
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="#inscribir" class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px">
        Reservar clase de prueba gratis
      </a>
    </div>
  </PageHero>

  <!-- Respuesta breve a la intención informativa y transaccional -->
  <section class="py-8 md:py-10 bg-white" aria-labelledby="resumen-padres">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <h2 id="resumen-padres" class="text-xl md:text-2xl">¿Por qué elegir Taekwon-Do para tu hijo o hija?</h2>
      <p class="text-text-soft max-w-[68ch] mt-3">
        Es una actividad marcial guiada que combina ejercicio, disciplina, respeto y confianza. Las escuelas afiliadas trabajan por edades y niveles, con instructores certificados y opciones para probar una clase antes de inscribirse.
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-5 text-sm text-text-soft">
        <li><strong class="text-ink">Edad:</strong> clases infantiles desde los 5 años, según cada escuela.</li>
        <li><strong class="text-ink">Seguridad:</strong> grupos por nivel, supervisión y protecciones en contacto.</li>
        <li><strong class="text-ink">Primer paso:</strong> encuentra una escuela y solicita una clase de prueba.</li>
      </ul>
    </div>
  </section>

  <!-- Beneficios -->
  <section id="beneficios" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="mb-8">
        <h2>Lo que tu hijo/a se lleva a casa</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {beneficios.map((b) => (
          <div class="bg-white border border-line rounded-sm overflow-hidden">
            <div class="p-5">
              <Tag variant={b.variante} style="margin-bottom:0.6em;">{b.etiqueta}</Tag>
              <p class="text-text-soft text-sm">{b.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Seguridad -->
  <section class="py-10 md:py-16" id="seguridad">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <img
        src={img.instructorInfantil}
        alt="Instructor supervisando entrenamiento infantil"
        class="rounded-sm w-full order-2 lg:order-1"
      />
      <div class="order-1 lg:order-2">
        <h2>Un ambiente seguro y supervisado</h2>
        <ul class="text-text-soft pl-5 leading-8 text-sm md:text-base">
          <li>Instructores certificados por FECHITAT e ITF</li>
          <li>Grupos separados por edad y nivel</li>
          <li>Protecciones obligatorias en todo contacto</li>
          <li>Seguro de accidentes en clases y competencias oficiales</li>
          <li>Comunicación directa con el instructor sobre el progreso</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10 md:py-16" id="faq">
    <div class="max-w-3xl mx-auto px-5 md:px-7">
      <h2 class="mb-6">Antes de inscribir</h2>
      <div class="border-t border-line">
        {faqs.map((faq) => (
          <details class="py-4 border-b border-line group">
            <summary class="cursor-pointer font-heading font-bold uppercase text-sm md:text-base list-none flex justify-between items-center gap-4">
              {faq.pregunta}
              <span class="text-text-soft transition-transform duration-200 group-open:rotate-45 text-lg">+</span>
            </summary>
            <p class="text-text-soft mt-3 text-sm md:text-base">{faq.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="py-10 md:py-16 bg-ink text-light" id="testimonios">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonios.map((t) => (
        <div>
          <p class="text-base md:text-lg text-white font-medium">{t.texto}</p>
          <span class="font-mono text-xs tracking-wider uppercase text-light-muted mt-2 block">— {t.autor}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Inscripción / clase de prueba -->
  <section id="inscribir" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <div>
        <h2>Reserva una clase de prueba gratuita</h2>
        <p class="text-text-soft">
          Completa el formulario y te contactaremos con la escuela más cercana a
          tu domicilio para coordinar la primera clase, sin costo ni compromiso.
        </p>
      </div>
      <form class="bg-white border border-line rounded-sm overflow-hidden p-5" id="form-clase-prueba">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="mb-4">
            <label for="nombre" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Nombre del niño/a</label>
            <input id="nombre" type="text" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1" />
          </div>
          <div class="mb-4">
            <label for="edad" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Edad</label>
            <input id="edad" type="number" min="4" max="17" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1" />
          </div>
        </div>
        <div class="mb-4">
          <label for="comuna" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Comuna</label>
          <input id="comuna" type="text" placeholder="Ej. La Serena" class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="mb-4">
            <label for="tel" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Teléfono de contacto</label>
            <input id="tel" type="tel" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1" />
          </div>
          <div class="mb-4">
            <label for="mail" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Correo</label>
            <input id="mail" type="email" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1" />
          </div>
        </div>
        <button type="submit" class="inline-flex items-center justify-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px w-full">
          Solicitar clase de prueba
        </button>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector('#form-clase-prueba');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
    });
  </script>
</BaseLayout>
