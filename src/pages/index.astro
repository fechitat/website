---
import EventBadge from "../components/EventBadge.astro";
import Stat from "../components/Stat.astro";
import Tag from "../components/Tag.astro";
import UIcon from "../components/icons/UIcon.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/hero/hero.webp";
import { img } from "../lib/imagenes";
import { getMetricas, getProximoEventoDestacado, getEscuelasPorRegion } from "../lib/sanityQueries";
import { getBlogPostsDestacados } from "../lib/blog";
import { urlFor } from "../lib/sanity";
import "leaflet/dist/leaflet.css";

// La portada se sirve dinámicamente sólo cuando sus noticias provienen de WordPress.
export const prerender = !process.env.WORDPRESS_URL;
export const revalidate = 3600;

const titulo = "FECHITAT — Federación Chilena de Taekwon-Do Tradicional";
const descripcion =
  "Encuentra dojangs afiliados, eventos y formación de Taekwon-Do ITF en Chile. Entrena con FECHITAT desde tu ciudad.";

// Datos de Sanity
const [metricas, proximoEvento, noticias, escuelas] = await Promise.all([
  getMetricas(),
  getProximoEventoDestacado(),
  getBlogPostsDestacados(),
  getEscuelasPorRegion(),
]);
const escuelasMapa = escuelas.map((escuela) => ({
  _id: escuela._id,
  nombre: escuela.nombre,
  slug: escuela.slug?.current ?? '',
  ciudad: escuela.ciudad ?? '',
  region: escuela.region ?? '',
  lat: escuela.ubicacion?.lat ?? null,
  lng: escuela.ubicacion?.lng ?? null,
  logoUrl: escuela.logoUrl ?? null,
}));
---

<BaseLayout title={titulo} description={descripcion}>
  <!-- Hero -->
  <section
    class="hero relative min-h-[75vh] md:min-h-[82vh] flex items-end text-white overflow-hidden bg-slate-950"
  >
    <Image
      src={heroImg}
      alt="Comunidad FECHITAT reunida en un entrenamiento de Taekwon-Do ITF"
      fill
      sizes="100vw"
      fetchpriority="high"
      class="absolute inset-0 object-cover object-[center_35%] opacity-60"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(11,18,32,0.3)_0%,rgba(11,18,32,0.6)_45%,rgba(11,18,32,0.98)_100%)]"
    >
    </div>
    <div
      class="relative z-10 py-16 md:py-24 pb-12 md:pb-16 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12"
    >
      <div class="max-w-3xl">
        <h1 class="text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold uppercase tracking-tight leading-[1.08] mb-5">
Taekwon-Do para crecer,<br />dentro y fuera del dojang
        </h1>
        <p
          class="text-base sm:text-lg md:text-xl text-slate-200 max-w-2xl mb-8 font-normal leading-relaxed"
        >
Encuentra una escuela afiliada, conoce nuestras actividades y entrena junto a la comunidad FECHITAT.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <Button href="#dojangs" variant="primary" size="md">
            Encuentra tu dojang
          </Button>
          <Button href="/federacion" variant="ghost" size="md">
            Conoce la federación
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Próximo evento -->
  {proximoEvento && (
    <section class="py-6 md:py-8 bg-white border-b border-line" id="eventos">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6 justify-between">
          <div class="flex items-center gap-4">
            <EventBadge
              mes={new Date(proximoEvento.fecha).toLocaleDateString('es-CL', {month: 'short'}).replace('.', '').toUpperCase()}
              dia={new Date(proximoEvento.fecha).getDate().toString()}
            />
            <div>
              <div class="font-heading font-bold text-base md:text-lg uppercase text-slate-900">
                {proximoEvento.titulo}
              </div>
              {(proximoEvento.lugar || proximoEvento.direccion || proximoEvento.ciudad) && (
                <div class="mt-0.5 flex items-center gap-1.5 text-xs text-text-soft">
                  <UIcon name="map-pin" size={13} />
                  <span>{[proximoEvento.lugar || proximoEvento.direccion, proximoEvento.ciudad].filter(Boolean).join(" · ")}</span>
                </div>
              )}
            </div>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
            <Button
              href={proximoEvento.slug?.current ? `/eventos/${proximoEvento.slug.current}` : "/eventos"}
              variant="primary"
              size="sm"
              class="w-full sm:w-auto text-center"
            >
              Ver evento
            </Button>
            <Button
              href="/eventos"
              variant="dark-ghost"
              size="sm"
              class="w-full sm:w-auto text-center"
            >
              Ver calendario completo
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Quiénes somos -->
  <section class="py-12 md:py-20 bg-white" id="quienes-somos">
    <div
      class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center"
    >
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight">
Una comunidad que crece<br />entrenando junta
        </h2>
        <p class="text-text-soft max-w-[54ch] mt-4 leading-relaxed text-base sm:text-lg">
Conectamos escuelas, instructores y practicantes para compartir formación,
          encuentros y experiencias de Taekwon-Do ITF en Chile. Cada dojang
          aporta su historia a esta comunidad.
        </p>
        <div class="h-px bg-line my-8"></div>
        <div class="grid grid-cols-2 gap-6">
          {metricas.length > 0 ? (
            metricas.map((m) => (
              <Stat count={m.valor} suffix={m.sufijo} label={m.titulo} />
            ))
          ) : (
            <>
              <Stat count={50} suffix="+" label="Cinturones negros" />
              <Stat count={150} suffix="+" label="Competidores activos" />
            </>
          )}
        </div>
      </div>
      <div>
        <img
          src={img.competidora}
          alt="Competidora de Taekwon-Do ITF con el uniforme nacional"
          width="1000"
          height="667"
          loading="lazy"
          decoding="async"
          class="rounded-lg w-full h-auto shadow-lg"
        />
      </div>
    </div>
  </section>

  <!-- Red de dojangs: búsqueda + mapa interactivo -->
  <section class="py-12 md:py-20 bg-paper border-t border-b border-line" id="dojangs">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Encuentra tu escuela más cercana</h2>
          <p class="text-text-soft text-sm md:text-base mt-2">
            Escribe una ciudad o nombre y localiza el dojang en el mapa.
          </p>
        </div>
        <a href="/escuelas" class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-red font-bold hover:underline">
          Ver todas las escuelas
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <div>
          <div class="relative">
            <label for="buscar-escuela" class="sr-only">Buscar escuela por ciudad o nombre</label>
            <input
              id="buscar-escuela"
              type="search"
              class="w-full border border-line bg-white p-3.5 md:p-4 font-body text-base rounded-lg focus:outline-2 focus:outline-blue focus:outline-offset-1 shadow-xs"
              placeholder="Buscar por ciudad o nombre…"
              autocomplete="off"
            />
          </div>
          <ul
            id="lista-escuelas"
            class="mt-3 list-none p-0 m-0 max-h-[440px] overflow-y-auto divide-y divide-line border border-line rounded-lg bg-white shadow-xs"
            aria-label="Resultados de escuelas"
            aria-live="polite"
          >
          </ul>
          <p id="estado-escuelas" class="sr-only" role="status" aria-live="polite"></p>
        </div>

        <div
          id="mapa-dojangs"
          class="h-[420px] lg:h-[496px] rounded-lg border border-line bg-paper z-0 shadow-xs overflow-hidden"
          aria-label="Mapa de dojangs afiliados"
          data-escuelas={JSON.stringify(escuelasMapa)}
          role="region"
        >
        </div>
      </div>
    </div>
  </section>

  <!-- Últimas noticias -->
  <section class="py-12 md:py-20 bg-white" id="noticias">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Últimas noticias</h2>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-red font-bold hover:underline"
        >
          Ver todo el blog
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {noticias.length > 0 ? (
          noticias.slice(0, 3).map((post) => (
            <a
              class="group flex flex-col bg-white border border-line rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-slate-300"
              href={`/blog/${post.slug?.current || '#'}`}
            >
              <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                {post.imagenUrl || post.imagen ? (
                  <img
                    src={post.imagenUrl ?? urlFor(post.imagen).width(600).auto('format').url()}
                    alt={post.imagenAlt ?? `Imagen de ${post.titulo}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full bg-slate-200"></div>
                )}
              </div>
              <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    {post.categorias?.[0] && <Tag>{post.categorias[0]}</Tag>}
                    {post.fecha && (
                      <time class="font-mono text-xs text-text-soft" datetime={post.fecha}>
                        {new Date(post.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </time>
                    )}
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-red transition-colors leading-snug line-clamp-2">
                    {post.titulo}
                  </h3>
                  {post.extracto && (
                    <p class="text-text-soft text-sm mt-2 line-clamp-2 leading-relaxed">
                      {post.extracto}
                    </p>
                  )}
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100">
                  <span class="font-mono text-xs uppercase tracking-wider text-red font-semibold group-hover:underline">
                    Leer artículo →
                  </span>
                </div>
              </div>
            </a>
          ))
        ) : (
          <>
            <a class="group flex flex-col bg-white border border-line rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl" href="/blog">
              <div class="aspect-[16/10] bg-cover bg-center overflow-hidden" style={`background-image:url('${img.postDefensa}');`} />
              <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <Tag variant="red">Ensayos</Tag>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-red transition-colors leading-snug">
                    Principios de la defensa personal
                  </h3>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100">
                  <span class="font-mono text-xs uppercase tracking-wider text-red font-semibold">Leer artículo →</span>
                </div>
              </div>
            </a>
            <a class="group flex flex-col bg-white border border-line rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl" href="/blog">
              <div class="aspect-[16/10] bg-cover bg-center overflow-hidden" style={`background-image:url('${img.postNacional}');`} />
              <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <Tag>Noticias</Tag>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-red transition-colors leading-snug">
                    Resultados del campeonato nacional
                  </h3>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100">
                  <span class="font-mono text-xs uppercase tracking-wider text-red font-semibold">Leer artículo →</span>
                </div>
              </div>
            </a>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import L from 'leaflet';

  function inicializarMapaDojangs() {
    const input = document.getElementById('buscar-escuela') as HTMLInputElement | null;
    const lista = document.getElementById('lista-escuelas') as HTMLUListElement | null;
    const estado = document.getElementById('estado-escuelas') as HTMLParagraphElement | null;
    const contenedorMapa = document.getElementById('mapa-dojangs') as HTMLElement | null;
    if (!input || !lista || !estado || !contenedorMapa || contenedorMapa.dataset.inicializado) return;
    contenedorMapa.dataset.inicializado = 'true';
    const escuelas = JSON.parse(contenedorMapa.dataset.escuelas || '[]');

  /** Cache de coordenadas geocodificadas (Nominatim) por ciudad, en localStorage. */
  const CACHE_GEO = 'fechitat:geo';
  const leerCache = (): Record<string, [number, number]> => {
    try { return JSON.parse(localStorage.getItem(CACHE_GEO) || '{}'); }
    catch { return {}; }
  };
  const guardarEnCache = (cache: Record<string, [number, number]>) => {
    try { localStorage.setItem(CACHE_GEO, JSON.stringify(cache)); } catch { /* sin storage */ }
  };

  /** Geocodifica una ciudad chilena con Nominatim (1 request/seg, sin API key). */
  async function geocodificar(ciudad: string, region = ''): Promise<[number, number] | null> {
    const cache = leerCache();
    const clave = `${ciudad}|${region}`;
    if (cache[clave]) return cache[clave];
    try {
      const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=cl&accept-language=es&q=${encodeURIComponent(`${ciudad}${region ? ', ' + region : ''}`)}`;
      const resp = await fetch(url, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(8000) });
      if (!resp.ok) return null;
      const datos = await resp.json();
      if (datos?.[0]) {
        const coord: [number, number] = [parseFloat(datos[0].lat), parseFloat(datos[0].lon)];
        cache[clave] = coord;
        guardarEnCache(cache);
        return coord;
      }
    } catch { /* red caída: sin coordinadas */ }
    return null;
  }

    // Mapa centrado en Chile
    const mapa = L.map(contenedorMapa, {
      center: [-35.6751, -71.5429],
      zoom: 5,
      scrollWheelZoom: false,
    });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mapa);

    const markers = new Map<string, { marker: L.Marker; coords: [number, number] }>();
    const tieneCoordenadas = (escuela) =>
      Number.isFinite(escuela.lat) && Number.isFinite(escuela.lng);

    const agregarMarcador = (escuela: any, coords: [number, number]) => {
      if (markers.has(escuela._id)) return;
      const popup = document.createElement('div');
      const nombrePopup = document.createElement('strong');
      nombrePopup.textContent = escuela.nombre;
      const ciudadPopup = document.createElement('span');
      ciudadPopup.textContent = escuela.ciudad ?? '';
      popup.append(nombrePopup, document.createElement('br'), ciudadPopup);
      if (escuela.slug) {
        const link = document.createElement('a');
        link.href = `/escuelas/${escuela.slug}`;
        link.className = 'inline-flex min-h-10 items-center justify-center mt-2 px-4 rounded-md bg-slate-900 text-white text-xs font-semibold hover:bg-slate-700 transition-colors';
        link.textContent = 'Ver dojang →';
        popup.append(link);
      }
      const icono = document.createElement('div');
      icono.className = 'w-11 h-11 bg-white border-2 border-itf-red rounded-full shadow-lg flex items-center justify-center overflow-hidden';
      if (escuela.logoUrl) {
        const logo = document.createElement('img');
        logo.src = escuela.logoUrl;
        logo.alt = '';
        logo.className = 'w-9 h-9 object-contain';
        logo.onerror = () => logo.replaceWith(document.createTextNode('🥋'));
        icono.appendChild(logo);
      } else {
        icono.textContent = '🥋';
      }
      const marker = L.marker(coords, {
        icon: L.divIcon({ html: icono, className: '', iconSize: [44, 44], iconAnchor: [22, 22] }),
        title: escuela.nombre,
      }).addTo(mapa).bindPopup(popup);
      markers.set(escuela._id, { marker, coords });
    };

    // Se construye la lista y cada resultado enfoca su marcador.
    const pintarLista = (filtro: string) => {
      const q = filtro.toLowerCase().trim();
      lista.innerHTML = '';
      let visibles = 0;
      escuelas.forEach((e: any) => {
        const nombre = e.nombre ?? '';
        const ciudad = e.ciudad ?? '';
        const region = e.region ?? '';
        if (q && !nombre.toLowerCase().includes(q) && !ciudad.toLowerCase().includes(q) && !region.toLowerCase().includes(q)) return;
        visibles++;
        const li = document.createElement('li');
        li.className = 'p-3 hover:bg-paper transition-colors flex items-center justify-between gap-2';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex-1 text-left cursor-pointer bg-transparent border-none p-0 font-body';
        const nombreElemento = document.createElement('span');
        nombreElemento.className = 'block text-sm font-medium';
        nombreElemento.textContent = nombre;
        const ubicacionElemento = document.createElement('span');
        ubicacionElemento.className = 'block text-xs text-text-soft';
        ubicacionElemento.textContent = `${ciudad}${region ? ` · ${region}` : ''}`;
        if (e.logoUrl) {
          const logo = document.createElement('img');
          logo.src = e.logoUrl;
          logo.alt = '';
          logo.loading = 'lazy';
          logo.className = 'w-9 h-9 object-contain mr-2';
          btn.appendChild(logo);
          btn.classList.add('flex', 'items-center');
        }
        const textos = document.createElement('span');
        textos.append(nombreElemento, ubicacionElemento);
        btn.appendChild(textos);
        btn.addEventListener('click', () => {
          const marcador = markers.get(e._id);
          if (marcador) {
            mapa.flyTo(marcador.coords, 13);
            marcador.marker.openPopup();
          }
        });
        li.appendChild(btn);

        if (e.slug) {
          const a = document.createElement('a');
          a.href = `/escuelas/${e.slug}`;
          a.className = 'inline-flex min-h-10 flex-none items-center justify-center rounded-md bg-slate-900 px-3 text-xs font-semibold text-white hover:bg-slate-700 transition-colors';
          a.textContent = 'Ver dojang';
          li.appendChild(a);
        }

        lista.appendChild(li);
      });
      estado.textContent = visibles === 0 ? 'No se encontraron escuelas con ese criterio.' : `${visibles} escuelas encontradas.`;
    };

    // Las coordenadas exactas de Sanity se muestran inmediatamente.
    escuelas.filter(tieneCoordenadas).forEach((escuela) => {
      agregarMarcador(escuela, [escuela.lat, escuela.lng]);
    });

    // Geocodificar las escuelas restantes, respetando la tasa de Nominatim.
    const ciudades = [...new Set(
      escuelas
        .filter((escuela) => !tieneCoordenadas(escuela))
        .map((e) => `${e.ciudad ?? ''}|||${e.region ?? ''}`)
    )].filter((c) => c !== '|||');
    (async () => {
      for (const clave of ciudades) {
        const [ciudad, region] = clave.split('|||');
        const coord = await geocodificar(ciudad, region);
        if (coord) {
          escuelas
            .filter((e) => !tieneCoordenadas(e) && (e.ciudad ?? '') === ciudad && (e.region ?? '') === region)
            .forEach((e) => agregarMarcador(e, coord));
        }
        await new Promise((r) => setTimeout(r, 1100));
      }
    })();

    input.addEventListener('input', () => pintarLista(input.value));
    pintarLista('');
  }

  inicializarMapaDojangs();
  document.addEventListener('astro:page-load', inicializarMapaDojangs);
</script>