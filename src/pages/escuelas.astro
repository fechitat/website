---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EscuelaCard from '../components/EscuelaCard.astro';
import { getEscuelas } from '../lib/sanityQueries';
import { normalizarTexto } from '../lib/utils';

export const prerender = true;
export const revalidate = 3600;

const titulo = 'Escuelas Afiliadas — FECHITAT';
const descripcion =
  'Busca escuelas afiliadas a FECHITAT por ciudad o región y encuentra dónde entrenar Taekwon-Do ITF en Chile.';

// Datos de Sanity
const escuelas = await getEscuelas();

// Agrupar por región
const escuelasPorRegion = escuelas.reduce((acc: any, escuela: any) => {
  const region = escuela.region || 'Sin región';
  if (!acc[region]) acc[region] = [];
  acc[region].push(escuela);
  return acc;
}, {});

const regiones = Object.keys(escuelasPorRegion).sort();

const jsonLdEscuelas = {
  "@context": "https://schema.org",
  "@graph": escuelas
    .filter((escuela: any) => escuela.ciudad || escuela.direccion)
    .map((escuela: any) => ({
      "@type": "SportsActivityLocation",
      name: escuela.nombre,
      url: "https://fechitat-website.vercel.app/escuelas",
      ...(escuela.email ? { email: escuela.email } : {}),
      ...(escuela.whatsapp ? { telephone: escuela.whatsapp } : {}),
      address: {
        "@type": "PostalAddress",
        ...(escuela.direccion ? { streetAddress: escuela.direccion } : {}),
        ...(escuela.ciudad ? { addressLocality: escuela.ciudad } : {}),
        ...(escuela.region ? { addressRegion: escuela.region } : {}),
        addressCountry: "CL",
      },
    })),
};
---

<BaseLayout title={titulo} description={descripcion} structuredData={jsonLdEscuelas}>
  <PageHero
    title="Escuelas afiliadas"
    crumb="Escuelas"
    description="Encuentra la escuela más cercana a tu ubicación. Todas las escuelas afiliadas a FECHITAT están certificadas por la ITF."
  />

  {/* Buscador y filtros de región */}
  <section class="py-10 md:py-16 border-b border-line">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex-1">
          <label for="buscar-escuela" class="sr-only">Buscar escuela por nombre, ciudad o región</label>
          <input
            id="buscar-escuela"
            type="text"
            class="w-full border border-line bg-white p-3 md:p-4 font-body text-base rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-1"
            placeholder="Buscar por nombre, ciudad o región..."
          />
        </div>
        <div class="flex gap-2 flex-wrap">
          <button
            class="filtro-region px-4 py-2 font-medium font-mono text-xs tracking-wider uppercase border border-line rounded-sm bg-ink text-white transition-colors duration-150"
            data-region="todas"
          >
            Todas
          </button>
          {regiones.map((region) => (
            <button
              class="filtro-region px-4 py-2 font-medium font-mono text-xs tracking-wider uppercase border border-line rounded-sm bg-white hover:bg-ink hover:text-white hover:border-ink transition-colors duration-150"
              data-region={normalizarTexto(region)}
            >
              {region}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Listado de escuelas */}
  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      {/* Escuelas por región */}
      <div id="lista-escuelas">
        {regiones.map((region) => (
          <div class="region-grupo mb-10" data-region={normalizarTexto(region)}>
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono text-xs tracking-wider uppercase text-text-soft">{region}</span>
              <span class="text-text-soft text-sm font-mono">({escuelasPorRegion[region].length})</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {escuelasPorRegion[region].map((escuela: any) => (
                <EscuelaCard escuela={escuela} regionNombre={region} />
              ))}
            </div>
          </div>
        ))}
      </div>

      {/* Sin resultados */}
      <div id="sin-resultados" class="hidden text-center py-12">
        <p class="text-text-soft text-lg mb-2">No se encontraron escuelas</p>
        <p class="text-text-soft text-sm">Intenta con otro término de búsqueda</p>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7 text-center">
      <h2 class="max-w-[20ch] mx-auto mb-4">Afilia tu escuela a FECHITAT</h2>
      <p class="text-text-soft max-w-[50ch] mx-auto mb-6">
        Si tienes una escuela de Taekwon-Do ITF y quieres ser parte de la federación, contáctanos para conocer los requisitos de afiliación.
      </p>
      <div class="flex justify-center">
        <a
          href="/federacion#directivos"
          class="inline-flex items-center justify-center gap-2 bg-ink text-white font-medium font-mono text-xs tracking-widest uppercase py-3.5 px-6 rounded-sm transition-all duration-150 hover:bg-black hover:-translate-y-px w-full sm:w-auto max-w-xs sm:max-w-none text-center"
        >
          Contactar directiva
        </a>
      </div>
    </div>
  </section>

  <script>
    function inicializarFiltroEscuelas() {
      const input = document.getElementById('buscar-escuela') as HTMLInputElement | null;
      const sinResultados = document.getElementById('sin-resultados');
      const listaEscuelas = document.getElementById('lista-escuelas');
      const regionGrupos = document.querySelectorAll('.region-grupo');
      const filtroBtns = document.querySelectorAll('.filtro-region');

      if (!input || !listaEscuelas || input.dataset.filtroInicializado) return;
      input.dataset.filtroInicializado = 'true';

      let regionActiva = 'todas';
      const normalizar = (texto: string) =>
        texto.toLocaleLowerCase('es-CL').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();

      function filtrar() {
        const busqueda = normalizar(input ? input.value : '');
        let total = 0;

        regionGrupos.forEach((grupo) => {
          const cards = grupo.querySelectorAll('.escuela-card');
          let visiblesEnRegion = 0;

          cards.forEach((card) => {
            const el = card as HTMLElement;
            const nombre = el.dataset.nombre || '';
            const ciudad = el.dataset.ciudad || '';
            const regionCard = el.dataset.region || '';
            const coincideRegion = regionActiva === 'todas' || regionCard === regionActiva;
            const coincideBusqueda = !busqueda || nombre.includes(busqueda) || ciudad.includes(busqueda) || regionCard.includes(busqueda);

            el.style.display = coincideRegion && coincideBusqueda ? '' : 'none';
            if (coincideRegion && coincideBusqueda) {
              visiblesEnRegion++;
              total++;
            }
          });

          (grupo as HTMLElement).style.display = visiblesEnRegion > 0 ? '' : 'none';
        });

        if (sinResultados) sinResultados.classList.toggle('hidden', total > 0);
        listaEscuelas.classList.toggle('hidden', total === 0);
      }

      input.addEventListener('input', filtrar);
      filtroBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          regionActiva = (btn as HTMLElement).dataset.region || 'todas';
          filtroBtns.forEach((elemento) => {
            const el = elemento as HTMLElement;
            const isActive = el.dataset.region === regionActiva;
            el.classList.toggle('bg-ink', isActive);
            el.classList.toggle('text-white', isActive);
            el.classList.toggle('bg-white', !isActive);
          });
          filtrar();
        });
      });

      filtrar();
    }

    inicializarFiltroEscuelas();
    document.addEventListener('astro:page-load', inicializarFiltroEscuelas);
  </script>
</BaseLayout>
