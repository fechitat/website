---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EscuelaCard from '../components/EscuelaCard.astro';
import { getDirectorioEscuelas } from '../lib/sanityQueries';

export const prerender = false;

const titulo = 'Escuelas Afiliadas — FECHITAT';
const descripcion = 'Busca escuelas afiliadas a FECHITAT por ciudad o región y encuentra dónde entrenar Taekwon-Do ITF en Chile.';
const busqueda = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);
const ciudad = Astro.url.searchParams.get('ciudad') ?? '';
const region = Astro.url.searchParams.get('region') ?? '';
const paginaSolicitada = Number(Astro.url.searchParams.get('pagina') ?? '1');
const pagina = Number.isSafeInteger(paginaSolicitada) && paginaSolicitada > 0 ? Math.min(paginaSolicitada, 10000) : 1;
const porPagina = 6;
const { escuelas, total, ubicaciones } = await getDirectorioEscuelas({ busqueda, ciudad, region, pagina }, porPagina);
const regiones = [...new Set(ubicaciones.map((u) => u.region || 'Sin región'))].sort((a, b) => a.localeCompare(b, 'es-CL'));
const ciudades = [...new Set(ubicaciones.map((u) => u.ciudad).filter((c): c is string => Boolean(c)))].sort((a, b) => a.localeCompare(b, 'es-CL'));
const totalPaginas = Math.ceil(total / porPagina);
const urlPagina = (numero: number) => {
  const params = new URLSearchParams();
  if (busqueda) params.set('q', busqueda);
  if (region) params.set('region', region);
  if (ciudad) params.set('ciudad', ciudad);
  if (numero > 1) params.set('pagina', String(numero));
  return `/escuelas${params.size ? `?${params.toString()}` : ''}`;
};
---

<BaseLayout title={titulo} description={descripcion}>
  <PageHero
    title="Escuelas afiliadas"
    crumb="Escuelas"
    description="Encuentra una escuela afiliada por nombre, ciudad o región."
  />

  <section class="py-8 md:py-12 bg-paper border-b border-line" aria-label="Buscar escuelas">
    <form action="/escuelas" method="get" class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
        <div class="sm:col-span-2 lg:col-span-2">
          <label for="buscar-escuela" class="block text-sm font-semibold text-slate-900 mb-2">Nombre o ubicación</label>
          <input id="buscar-escuela" name="q" type="search" value={busqueda} maxlength="80"
            class="w-full min-h-12 border border-slate-300 bg-white px-4 rounded-lg font-body text-base focus:outline-2 focus:outline-itf-blue focus:outline-offset-1"
            placeholder="Ej. Taekwon-Do, Ovalle, Coquimbo…" />
        </div>
        <div>
          <label for="filtrar-region" class="block text-sm font-semibold text-slate-900 mb-2">Región</label>
          <select id="filtrar-region" name="region" class="w-full min-h-12 border border-slate-300 bg-white px-3 rounded-lg text-base focus:outline-2 focus:outline-itf-blue">
            <option value="">Todas las regiones</option>
            {regiones.map((opcion) => <option value={opcion} selected={opcion === region}>{opcion}</option>)}
          </select>
        </div>
        <div>
          <label for="filtrar-ciudad" class="block text-sm font-semibold text-slate-900 mb-2">Ciudad</label>
          <select id="filtrar-ciudad" name="ciudad" class="w-full min-h-12 border border-slate-300 bg-white px-3 rounded-lg text-base focus:outline-2 focus:outline-itf-blue">
            <option value="">Todas las ciudades</option>
            {ciudades.map((opcion) => <option value={opcion} selected={opcion === ciudad}>{opcion}</option>)}
          </select>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 mt-5">
        <button type="submit" class="min-h-11 px-6 rounded-lg bg-slate-900 text-white font-semibold hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-itf-blue">Buscar escuelas</button>
        <a href="/escuelas" class="min-h-11 px-6 inline-flex items-center justify-center rounded-lg border border-slate-300 text-slate-800 font-semibold hover:bg-white">Limpiar filtros</a>
      </div>
    </form>
  </section>

  <section class="py-10 md:py-16" aria-label="Resultados de escuelas">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <p class="text-sm text-text-soft mb-6" role="status">{total} {total === 1 ? 'escuela encontrada' : 'escuelas encontradas'}{total > 0 ? ` · Página ${pagina} de ${totalPaginas}` : ''}</p>
      {escuelas.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {escuelas.map((escuela) => <EscuelaCard escuela={escuela} />)}
        </div>
      ) : (
        <div class="bg-paper rounded-xl border border-line p-8 text-center">
          <p class="text-slate-900 font-semibold">No se encontraron escuelas con esos filtros.</p>
          <p class="text-text-soft text-sm mt-2">Prueba otra ciudad, región o término de búsqueda.</p>
          <a href="/escuelas" class="inline-block text-itf-red font-semibold mt-4 hover:underline">Ver todas las escuelas</a>
        </div>
      )}
      {totalPaginas > 1 && (
        <nav aria-label="Páginas de escuelas" class="flex items-center justify-center gap-4 mt-10">
          {pagina > 1 && <a href={urlPagina(pagina - 1)} class="min-h-11 px-4 inline-flex items-center rounded-lg border border-line hover:bg-paper">← Anterior</a>}
          <span class="text-sm text-text-soft">{pagina} de {totalPaginas}</span>
          {pagina < totalPaginas && <a href={urlPagina(pagina + 1)} class="min-h-11 px-4 inline-flex items-center rounded-lg border border-line hover:bg-paper">Siguiente →</a>}
        </nav>
      )}
    </div>
  </section>

  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7 text-center">
      <h2 class="max-w-[20ch] mx-auto mb-4">Afilia tu escuela a FECHITAT</h2>
      <p class="text-text-soft max-w-[50ch] mx-auto mb-6">Si tienes una escuela de Taekwon-Do ITF y quieres ser parte de la federación, contáctanos para conocer los requisitos de afiliación.</p>
      <a href="/federacion#directivos" class="inline-flex min-h-11 items-center justify-center bg-ink text-white font-medium font-mono text-xs tracking-widest uppercase py-3.5 px-6 rounded-sm hover:bg-black">Contactar directiva</a>
    </div>
  </section>
</BaseLayout>
