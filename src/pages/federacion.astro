---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import Button from '../components/ui/Button.astro';
import { getOrganigrama, getComisiones, getCampeones, getHitoHistorico } from '../lib/sanityQueries';
import { urlFor } from '../lib/sanity';

export const prerender = true;
export const revalidate = 3600;

const titulo = 'Sobre FECHITAT — Federación de Taekwon-Do ITF';
const descripcion =
  'Conoce FECHITAT, la federación chilena de Taekwon-Do ITF: historia, directiva, comisiones, campeones y afiliación oficial.';

// Obtener datos de Sanity
const [directivos, comisiones, campeones, hitos] = await Promise.all([
  getOrganigrama(),
  getComisiones(),
  getCampeones(),
  getHitoHistorico(),
]);
---

<BaseLayout title={titulo} description={descripcion}>
  <PageHero
    title="Sobre FECHITAT"
    crumb="FECHITAT"
  />

  <!-- Quiénes somos -->
  <section id="quienes" class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 leading-tight">
          Más que una federación, una familia
        </h2>
        <p class="text-slate-600 text-sm md:text-base mt-4 leading-relaxed">
          FECHITAT agrupa escuelas de todo Chile bajo un mismo sello: el Taekwon-Do ITF Original. Certificación oficial de grados por la ITF, competencias nacionales e internacionales y una comunidad que entrena con disciplina, respeto y proyección de excelencia.
        </p>
        <p class="text-slate-600 text-sm md:text-base mt-3 leading-relaxed">
Reunimos a escuelas e instructores para fortalecer la formación, organizar encuentros y abrir oportunidades de participación a practicantes de distintas edades y regiones.
        </p>
      </div>
      <div>
        <img
          src="/images/hero/OIP.webp"
          alt="Equipo nacional de Taekwon-Do ITF junto a la bandera de Chile"
          class="rounded-xl w-full h-auto shadow-md object-cover border border-slate-200"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Línea de tiempo -->
  {hitos.length > 0 && (
    <section class="py-12 md:py-16 bg-slate-50 border-t border-b border-slate-200" id="historia">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Línea de tiempo de la federación</h2>
        </div>
        <Timeline hitos={hitos} />
      </div>
    </section>
  )}

  <!-- Directorio -->
  {directivos.length > 0 && (
    <section id="directivos" class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Directorio Oficial</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {directivos.map((d) => (
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition-shadow flex flex-row sm:flex-col justify-between">
              <div class="flex items-center sm:block min-w-0">
                {/* Foto o iniciales */}
                <div class="w-20 h-20 flex-none sm:w-full sm:h-auto sm:aspect-4/5 overflow-hidden bg-slate-100">
                  {d.foto ? (
                    <img
                      src={urlFor(d.foto).width(400).height(500).url()}
                      alt={d.nombre}
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-700 font-bold text-3xl">
                      {d.nombre.split(' ').map((n: string) => n[0]).join('')}
                    </div>
                  )}
                </div>

                {/* Info */}
                <div class="p-3 sm:p-5 text-left sm:text-center min-w-0">
                  <h3 class="text-base md:text-lg font-bold text-slate-900 leading-snug">{d.nombre}</h3>
                  <p class="text-xs font-semibold text-itf-blue uppercase tracking-wider mt-1">{d.cargo}</p>
                  {d.grado && <p class="text-xs text-slate-500 mt-0.5">{d.grado}</p>}
                </div>
              </div>

              {/* Botón de contacto */}
              {d.email && (
                <div class="p-3 sm:px-5 sm:pb-5 sm:pt-0 flex items-center sm:block">
                  <Button href={`mailto:${d.email}`} variant="secondary" size="sm" class="w-full justify-center">
                    Contactar
                  </Button>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Comisiones -->
  {comisiones.length > 0 && (
    <section id="comisiones" class="py-12 md:py-16 bg-slate-50 border-t border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Comisiones de Trabajo</h2>
          <p class="text-slate-600 text-sm md:text-base mt-1 max-w-2xl">
            Equipos técnicos y multidisciplinarios que apoyan la gestión deportiva, formativa y reglamentaria de FECHITAT.
          </p>
        </div>

        <div class="space-y-6">
          {comisiones.map((comision) => (
            <article class="bg-white border border-slate-200 rounded-xl p-6 md:p-8 shadow-xs">
              <h3 class="text-xl font-bold text-slate-900">{comision.nombre}</h3>
              {comision.descripcion && (
                <p class="text-slate-600 text-sm leading-relaxed mt-2 mb-6 max-w-3xl">
                  {comision.descripcion}
                </p>
              )}
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 border-t border-slate-100 pt-6">
                {comision.miembros?.map((miembro) => (
                  <div class="flex items-center gap-3.5 p-3 rounded-lg bg-slate-50 border border-slate-100">
                    {miembro.foto ? (
                      <img
                        src={urlFor(miembro.foto).width(96).height(96).url()}
                        alt={miembro.nombre}
                        class="w-12 h-12 rounded-full object-cover flex-none border border-slate-200"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="w-12 h-12 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-sm flex-none">
                        {miembro.nombre.split(' ').map((n: string) => n[0]).join('')}
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <h4 class="text-sm font-semibold text-slate-900 truncate">{miembro.nombre}</h4>
                      {miembro.email && (
                        <a href={`mailto:${miembro.email}`} class="text-xs text-itf-blue hover:underline block truncate mt-0.5">
                          {miembro.email}
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Salón de campeones / Maestros que marcaron escuela -->
  {campeones.length > 0 && (
    <section class="py-12 md:py-16 bg-slate-50 border-t border-b border-slate-200" id="campeones">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <span class="font-mono text-xs tracking-wider uppercase text-itf-blue font-semibold block mb-1">Legado y Maestría</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Maestros que marcaron escuela</h2>
          <p class="text-slate-600 text-sm md:text-base mt-1">Reconocimiento a quienes han forjado el Taekwon-Do ITF en Chile a través de su trayectoria y logros internacionales.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {campeones.map((c) => (
            <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs hover:shadow-md transition-shadow flex items-center gap-4">
              {c.foto ? (
                <img
                  src={urlFor(c.foto).width(128).height(128).url()}
                  alt={c.nombre}
                  class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover flex-none border border-slate-200"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-base flex-none border border-slate-200">
                  {c.nombre.split(' ').map((n: string) => n[0]).join('')}
                </div>
              )}
              <div class="min-w-0">
                <span class="font-mono text-xs tracking-wider uppercase text-itf-blue font-semibold block">
                  {c.grado}{c.titulo ? ` · ${c.titulo}` : ''}
                </span>
                <h3 class="text-base md:text-lg font-bold text-slate-900 m-0 truncate">{c.nombre}</h3>
                {c.competencia && <p class="text-slate-500 text-xs mt-1">{c.competencia} {c.anio}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Beneficios de afiliación -->
  <section id="afiliacion" class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Por qué afiliar tu escuela a FECHITAT</h2>
        <p class="text-slate-600 text-sm md:text-base mt-2 leading-relaxed">
          Al integrar tu escuela a la federación, tus practicantes e instructores obtienen respaldo institucional, acreditación internacional y acceso a todas las actividades oficiales del circuito federado.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 mb-8">
        <div class="p-5 rounded-xl border border-slate-200 bg-slate-50">
          <div class="w-8 h-8 rounded-lg bg-itf-blue-light text-itf-blue flex items-center justify-center mb-3 font-bold">✓</div>
          <h3 class="text-base font-bold text-slate-900">Presencia activa a nivel internacional</h3>
          <p class="text-slate-600 text-xs md:text-sm mt-1 leading-relaxed">
            Representación oficial ante la International Taekwon-Do Federation (ITF) con acceso a torneos panamericanos y mundiales.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-slate-200 bg-slate-50">
          <div class="w-8 h-8 rounded-lg bg-itf-blue-light text-itf-blue flex items-center justify-center mb-3 font-bold">✓</div>
          <h3 class="text-base font-bold text-slate-900">Certificación oficial de grados</h3>
          <p class="text-slate-600 text-xs md:text-sm mt-1 leading-relaxed">
            Registro y homologación federativa de exámenes de grado Gup y diplomas internacionales de cinturón negro Dan.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-slate-200 bg-slate-50">
          <div class="w-8 h-8 rounded-lg bg-itf-blue-light text-itf-blue flex items-center justify-center mb-3 font-bold">✓</div>
          <h3 class="text-base font-bold text-slate-900">Seminarios y capacitación continua</h3>
          <p class="text-slate-600 text-xs md:text-sm mt-1 leading-relaxed">
            Participación preferente en cursos para instructores, árbitros y seminarios técnicos con Maestros invitados.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-slate-200 bg-slate-50">
          <div class="w-8 h-8 rounded-lg bg-itf-blue-light text-itf-blue flex items-center justify-center mb-3 font-bold">✓</div>
          <h3 class="text-base font-bold text-slate-900">Circuito nacional de torneos</h3>
          <p class="text-slate-600 text-xs md:text-sm mt-1 leading-relaxed">
            Cobertura y seguro deportivo en el calendario nacional oficial, con llaves y reglamentos estandarizados.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
        <Button
          href="mailto:contacto@fechitat.cl"
          variant="primary"
          size="md"
          class="w-full sm:w-auto text-center"
        >
          Solicitar afiliación institucional
        </Button>
        <Button
          href="/escuelas"
          variant="secondary"
          size="md"
          class="w-full sm:w-auto text-center"
        >
          Ver escuelas actualmente afiliadas
        </Button>
      </div>
    </div>
  </section>

</BaseLayout>
