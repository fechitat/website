---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BlogListado from '../components/BlogListado.astro';
import { getBlogPosts, getTotalBlogPosts } from '../lib/blog';

export const prerender = false;

const porPagina = 12;
const descripcion = 'Noticias, técnica e historia del Taekwon-Do ITF en Chile, publicadas por FECHITAT.';
const [posts, total] = await Promise.all([getBlogPosts(1, porPagina), getTotalBlogPosts()]);
const totalPaginas = Math.max(1, Math.ceil(total / porPagina));
---

<BaseLayout title="Noticias y Blog — FECHITAT" description={descripcion}>
  <!-- Distinción explícita de la sección de Recursos -->
  <div class="bg-paper border-b border-line py-2 px-4 text-xs font-mono text-center text-text-soft">
    <span>¿Buscas el programa de examen, manual de teoría o cronómetro para clases?</span>
    <a href="/recursos" class="font-bold text-red hover:underline ml-1 inline-flex items-center gap-1">
      Ir a Recursos ITF (PWA) →
    </a>
  </div>

  <PageHero
    title="Noticias y Blog"
    crumb="Inicio"
    crumbHref="/"
    accent="blue"
    description={descripcion}
  />
  <BlogListado posts={posts} actual={1} totalPaginas={totalPaginas} />
</BaseLayout>
