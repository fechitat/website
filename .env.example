PUBLIC_SANITY_PROJECT_ID=wyg7m2t0
PUBLIC_SANITY_DATASET=production
# Al configurarlo en el servidor, noticias y portada usan WordPress en vez de Sanity.
# No añadir credenciales: sólo se consultan entradas públicas desde Astro.
# Local: WORDPRESS_URL=http://127.0.0.1:8080
# CMS: configurar WORDPRESS_URL sólo cuando el destino responda /wp-json/wp/v2/posts.
# cms.fechitat-website.vercel.app aún no es una URL operativa de WordPress.
# Dominio definitivo previsto: https://cms.fechitat.cl
# Analítica opcional en desarrollo
PUBLIC_GA_ID=G-XXXXXXXXXX
# Redes oficiales verificadas: dejar sin configurar hasta confirmar las URLs.
# PUBLIC_FECHITAT_INSTAGRAM=https://www.instagram.com/...
# PUBLIC_FECHITAT_FACEBOOK=https://www.facebook.com/...
# PUBLIC_FECHITAT_YOUTUBE=https://www.youtube.com/...
